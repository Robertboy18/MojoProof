import MojoProofTest.SymChain
import MojoProofTest.KernelWarps

/-!
# The kernel theorem with a barrier, on a kernel with a barrier and two shuffles

A test of `Kernel.sound_of_prefixes`, `Kernel.Prefixes`, `WarpSegsTo`, `Kernel.run_of_phases`,
`WarpSegsBar` and `WarpSegsBar.wait` (MojoProof/Sym/KernelWarps.lean) on SymColl's kernel `kern`
(MojoProofTest/SymColl.lean: a barrier, then two butterfly shuffles at offsets 1 and 2),
launched on one block of 4 and of 8 threads (`SymChain.L k`, one warp), no arguments, on the
empty memory, at the one admitted address choice and oracle, 0 (`adm0`,
MojoProofTest/KernelWarps.lean's). The kernel is written by hand in
the parser's form (a `Func`), not imported from the corpus, and the theorem's premises are
supplied here from SymChain's lemmas (`waits`, `lane`, `shfls`, `checks`), not generated by
`mojo_kernel`.

* `seg_bar`: the warp's phase to the barrier (`WarpSegsBar` at the word 0), its lanes' runs past
  the barrier to their ends;
* `seg_to`: the same phase cut at the barrier (`WarpSegsTo`), from the runs to the barrier alone;
* `seg_end`: the warp's phase past the barrier, through the two shuffles to the returns
  (`WarpSegs`);
* `phases`: the premises of `Kernel.sound_of_phases` and `Kernel.run_of_phases` on the phases,
  at one barrier;
* `prefixes`: `Kernel.Prefixes` at one barrier, the phase to it by `seg_to`;
* `run`: the start's grid runs to a done grid whose memory is the one past the barrier
  (`Kernel.run_of_phases`, no end checks);
* `sound`: the kernel is sound (`Kernel.Sound`) at that launch and admission, with the
  observation of the blocks and the postcondition that they are the start's (`blocks_end`), the
  trace's checks by SymChain's `checks` (`Kernel.sound_of_prefixes` at `prefixes`);
* `bar_other_to`, `bar_other`: the twins, the warp's `WarpSegsTo` and `WarpSegsBar` at a barrier
  word other than 0 refused.

Statements about this kernel at these launches, memory and admission, not about every kernel.
-/

namespace MojoProofTest.KernelPhases

open MojoProof MojoProof.LLVM MojoProof.Sem MojoProof.Sym
open MojoProofTest.SymChain (L ph memAt stop c g0 start_eq waits lane shfls lanes block size
  checks)
open MojoProofTest.KernelWarps (adm0)

-- `Array.any` recurses by well-founded recursion, so `rfl` cannot evaluate a step without this.
unseal Array.anyM.loop

/-- Lane `j`'s barrier wait at `k` threads: at position 1 of block 0, the barrier call on the word
0, on the memory after the first `j + 1` threads' runs from the start, delivering no value and the
memory past the barrier `(ph k 1).2`. -/
def bw (k j : Nat) : Piece.Wait :=
  ⟨1, .barrier, [.bits 32 0], memAt k (ph k 0).1 (ph k 0).2 (j + 1), (none, (ph k 1).2)⟩

/-- The phases' threads at `k` threads: thread `n` in phase `i` is SymChain's `(ph k i).1 n` (the
start's thread, then the one resumed past the barrier). -/
def T (k : Nat) : Nat → Nat → Nat → Thread → Prop := fun _ i n t => t = (ph k i).1 n

/-- The memories at `k` threads, by block, phase and number of the phase's warps done: the start's
before the first warp, the one after the `k` threads' runs to the barrier after it, and the
memory past the barrier `(ph k 1).2` from the barrier on (no lane changes it after). -/
def pm (k : Nat) : Nat → Nat → Nat → Mem
  | 0, 0, 0 => (ph k 0).2
  | 0, 0, _ => memAt k (ph k 0).1 (ph k 0).2 k
  | _, _, _ => (ph k 1).2

/-- The memory predicates at `k` threads: equal to `pm k`'s. -/
def P (k : Nat) : Nat → Nat → Nat → Mem → Prop := fun b i w m => m = pm k b i w

/-- At 4 and at 8 threads, each thread's run from the start stops at block 0, position 1 of the
kernel (the barrier), by the kernel's evaluation. -/
theorem at_bar (k : Nat) (hk : k = 4 ∨ k = 8) : ∀ j < k,
    (stop k (ph k 0).1 (ph k 0).2 j).at = some (SymColl.kern.name, 0, 1) := by
  intro j hj
  rcases hk with rfl | rfl <;> interval_cases j <;> kernel_rfl

/-- At 4 and at 8 threads, the blocks of the memory past the barrier are the start's, by the
kernel's evaluation: the kernel stores nothing. -/
theorem blocks_end (k : Nat) (hk : k = 4 ∨ k = 8) : (ph k 1).2.blocks = (g0 k).mem.blocks := by
  rcases hk with rfl | rfl <;> kernel_rfl

/-- **The warp's phase to the barrier has `WarpSegsBar`**, at 4 and at 8 threads, from the start's
threads on the start's memory: no shuffle before the barrier (`J = 0`) out of three waits, the
barrier wait `bw k j` then SymColl's two shuffles; each lane's run through them by `waits` (to
the barrier, at `at_bar`) and SymChain's `lane` (past it), through `RunsVia.of_block`; the lanes
resumed with no value are the phase-1 threads `(ph k 1).1`, by `statusAt` at `waits`; the memory
after the warp is the one after the `k` threads' runs. -/
theorem seg_bar (k : Nat) (hk : k = 4 ∨ k = 8) (t : Nat → Thread)
    (ht : ∀ j ∈ warpLanes (L k) 0, t (0 + j) = (ph k 0).1 (0 + j)) :
    WarpSegsBar SymColl.prog SymColl.kern (L k) (c k) 0 t (ph k 0).2 0 0 1 (T k 0 1)
      (P k 0 0 1) := by
  have hl : ∀ j ∈ warpLanes (L k) 0, j < k := fun j hj => List.mem_range.1 (lanes k hk ▸ hj)
  have hN : (warpLanes (L k) 0).length = k := by rw [lanes k hk, List.length_range]
  refine ⟨0, 3, fun _ => 0, fun _ => .bfly, fun _ => 0, fun _ => 0, fun _ => 0,
    fun _ _ => .poison, ⟨0, .barrier, [], {}, (none, {})⟩,
    fun j => bw k j :: SymColl.ws (ph k 1).2 j, fun _ j => memAt k (ph k 0).1 (ph k 0).2 j,
    fun _ => (· = (ph k 1).2), by omega, rfl, ?_, fun j hj => ?_, fun _ _ => rfl,
    fun _ h => absurd h (by omega), fun _ h => absurd h (by omega),
    fun _ h => absurd h (by omega), rfl, fun j hj => ⟨rfl, rfl, ⟨_, rfl, rfl⟩, rfl, rfl⟩,
    fun j hj u e hs _ _ => ?_⟩
  · show memAt k (ph k 0).1 (ph k 0).2 (warpLanes (L k) 0).length = pm k 0 0 1
    rw [hN]
    rfl
  · rw [ht j hj]
    refine RunsVia.of_block (l := 0) ?_ rfl (fun _ _ => rfl) fun _ h => h
    have hr := lane k hk j (hl j hj)
    rw [Nat.zero_add] at hr ⊢
    obtain ⟨s, m', hw, rfl, rfl⟩ :=
      waits k hk 0 (by omega) j (by rw [size k hk]; exact hl j hj) _ _ rfl rfl
    exact ⟨_, _, _, _, _, hw, ⟨at_bar k hk j (hl j hj), rfl, rfl, rfl⟩, hr⟩
  · rw [ht j hj] at hs
    simp only [List.range_zero, List.map_nil, statusAt, Nat.zero_add] at hs ⊢
    obtain ⟨s', m', hw, rfl, rfl⟩ :=
      waits k hk 0 (by omega) j (by rw [size k hk]; exact hl j hj) _ _ rfl rfl
    rw [nextWait_eq hw] at hs
    obtain ⟨rfl, -, -, -⟩ := Status.wait.inj hs
    rfl

/-- **The warp's phase to the barrier has `WarpSegsTo`**, at 4 and at 8 threads, from the start's
threads on the start's memory, from SymChain's `waits` alone: no shuffle before the barrier
(`J = 0`), the one wait the barrier's `bw k j`, each lane's run to it by `waits` (at `at_bar`),
nothing past the barrier (`seg_bar` needs SymChain's `lane` there too); the lanes resumed with no
value are the phase-1 threads `(ph k 1).1`, by `statusAt` at `waits`; the memory after the warp is
the one after the `k` threads' runs. -/
theorem seg_to (k : Nat) (hk : k = 4 ∨ k = 8) (t : Nat → Thread)
    (ht : ∀ j ∈ warpLanes (L k) 0, t (0 + j) = (ph k 0).1 (0 + j)) :
    WarpSegsTo SymColl.prog SymColl.kern (L k) (c k) 0 t (ph k 0).2 0 0 1 (T k 0 1)
      (P k 0 0 1) := by
  have hl : ∀ j ∈ warpLanes (L k) 0, j < k := fun j hj => List.mem_range.1 (lanes k hk ▸ hj)
  have hN : (warpLanes (L k) 0).length = k := by rw [lanes k hk, List.length_range]
  refine ⟨0, fun _ => 0, fun _ => .bfly, fun _ => 0, fun _ => 0, fun _ => 0,
    fun _ _ => .poison, ⟨0, .barrier, [], {}, (none, {})⟩, fun j => [bw k j],
    fun _ j => memAt k (ph k 0).1 (ph k 0).2 j, rfl, ?_, fun j hj => ?_, fun _ _ => rfl,
    fun _ h => absurd h (by omega), fun _ h => absurd h (by omega),
    fun _ h => absurd h (by omega), rfl, fun j hj => ⟨rfl, rfl, ⟨_, rfl, rfl⟩, rfl, rfl⟩,
    fun j hj u e hs _ => ?_⟩
  · show memAt k (ph k 0).1 (ph k 0).2 (warpLanes (L k) 0).length = pm k 0 0 1
    rw [hN]
    rfl
  · rw [ht j hj]
    simp only [Nat.zero_add]
    obtain ⟨s, m', hw, rfl, rfl⟩ :=
      waits k hk 0 (by omega) j (by rw [size k hk]; exact hl j hj) _ _ rfl rfl
    exact ⟨_, _, _, _, _, hw, ⟨at_bar k hk j (hl j hj), rfl, rfl, rfl⟩, trivial⟩
  · rw [ht j hj] at hs
    simp only [List.range_zero, List.map_nil, statusAt, Nat.zero_add] at hs ⊢
    obtain ⟨s', m', hw, rfl, rfl⟩ :=
      waits k hk 0 (by omega) j (by rw [size k hk]; exact hl j hj) _ _ rfl rfl
    rw [nextWait_eq hw] at hs
    obtain ⟨rfl, -, -, -⟩ := Status.wait.inj hs
    rfl

/-- **The warp's phase past the barrier has `WarpSegs`**, at 4 and at 8 threads, from the phase-1
threads on the memory past the barrier: SymColl's two butterfly shuffles at offsets 1 and 2, the
lanes' runs by SymChain's `lane`, the waits passing `Piece.Wait.shflOk` by SymChain's `shfls`,
the deliveries kept by `Program.shfl_nil`, the memories by `SymColl.mems`; the memory after the
warp is the one past the barrier. -/
theorem seg_end (k : Nat) (hk : k = 4 ∨ k = 8) (t : Nat → Thread)
    (ht : ∀ j ∈ warpLanes (L k) 0, t (0 + j) = (ph k 1).1 (0 + j)) :
    WarpSegs SymColl.prog SymColl.kern (L k) (c k) 0 t (ph k 1).2 (P k 0 1 1) := by
  have hl : ∀ j ∈ warpLanes (L k) 0, j < k := fun j hj => List.mem_range.1 (lanes k hk ▸ hj)
  refine ⟨2, fun _ => 0, fun _ => .bfly, fun i => if i = 0 then 2 else 4,
    fun i => if i = 0 then 1 else 2, fun _ => 31, SymColl.x, ⟨0, .barrier, [], {}, (none, {})⟩,
    SymColl.ws (ph k 1).2, fun _ _ => (ph k 1).2, rfl, rfl, fun j hj => ?_,
    fun j hj => shfls k hk j (hl j hj), fun _ _ _ _ => Program.shfl_nil (by decide),
    fun i hi j hj => SymColl.mems i hi j hj, fun _ _ => rfl⟩
  rw [ht j hj]
  exact RunsVia.of_block (lane k hk j (hl j hj)) rfl (fun _ _ => rfl) fun _ h => h

/-- **SymColl's kernel's phases**, at one block of 4 and of 8 threads (`SymChain.L k`, one warp):
`Kernel.sound_of_phases`' and `Kernel.run_of_phases`' premises on the phases at one barrier
(`J = 1`), the threads `T k` and the memories `P k`: the phase to the barrier by `seg_bar` at the
word 0, block 0 and position 1, the barrier's log by `pm`, the phase past it by `seg_end`. -/
theorem phases (k : Nat) (hk : k = 4 ∨ k = 8) :
    (∀ b < volume (L k).grid, ∀ i < 1, ∃ bar < 16, ∃ l p,
      ∀ w (hw : w < (blockWarps (L k) b).length), ∀ t m₀,
        (∀ j ∈ warpLanes (L k) (blockWarps (L k) b)[w],
          T k b i ((blockWarps (L k) b)[w] + j) (t ((blockWarps (L k) b)[w] + j))) →
        P k b i w m₀ →
        WarpSegsBar SymColl.prog SymColl.kern (L k) (c k) (blockWarps (L k) b)[w] t m₀ bar l p
          (T k b (i + 1)) (P k b i (w + 1))) ∧
    (∀ b < volume (L k).grid, ∀ i < 1, ∀ m₁, P k b i (blockWarps (L k) b).length m₁ →
      P k b (i + 1) 0 (m₁.log (.barrier b))) ∧
    (∀ b < volume (L k).grid, ∀ w (hw : w < (blockWarps (L k) b).length), ∀ t m₀,
      (∀ j ∈ warpLanes (L k) (blockWarps (L k) b)[w],
        T k b 1 ((blockWarps (L k) b)[w] + j) (t ((blockWarps (L k) b)[w] + j))) →
      P k b 1 w m₀ →
      WarpSegs SymColl.prog SymColl.kern (L k) (c k) (blockWarps (L k) b)[w] t m₀
        (P k b 1 (w + 1))) ∧
    ∀ b < volume (L k).grid, ∀ m₁, P k b 1 (blockWarps (L k) b).length m₁ →
      P k (b + 1) 0 0 m₁ := by
  have hb : blockWarps (L k) 0 = [0] := by rcases hk with rfl | rfl <;> decide
  have hg : volume (L k).grid = 1 := by rcases hk with rfl | rfl <;> rfl
  refine ⟨fun b hb' i hi => ?_, fun b hb' i hi m₁ hm₁ => ?_, fun b hb' w hw t m₀ ht hm₀ => ?_,
    fun b hb' m₁ hm₁ => ?_⟩
  · obtain rfl : b = 0 := by omega
    obtain rfl : i = 0 := Nat.lt_one_iff.1 hi
    refine ⟨0, by decide, 0, 1, fun w hw t m₀ ht hm₀ => ?_⟩
    obtain rfl : w = 0 := by simp only [hb, List.length_cons, List.length_nil] at hw; omega
    simp only [hb, List.getElem_cons_zero] at ht ⊢
    subst hm₀
    exact seg_bar k hk t ht
  · obtain rfl : b = 0 := by omega
    obtain rfl : i = 0 := Nat.lt_one_iff.1 hi
    rw [hm₁, hb]
    rfl
  · obtain rfl : b = 0 := by omega
    obtain rfl : w = 0 := by simp only [hb, List.length_cons, List.length_nil] at hw; omega
    simp only [hb, List.getElem_cons_zero] at ht ⊢
    subst hm₀
    exact seg_end k hk t ht
  · obtain rfl : b = 0 := by omega
    exact hm₁

/-- **SymColl's kernel's phases, the one to the barrier cut there**, at one block of 4 and of 8
threads (`SymChain.L k`, one warp): `Kernel.Prefixes` at one barrier (`J = 1`), the threads `T k`
and the memories `P k`: the start's threads and memory, the phase to the barrier by `seg_to` at
the word 0, block 0 and position 1, the barrier's log, the phase past it and the block's end by
`phases`. -/
theorem prefixes (k : Nat) (hk : k = 4 ∨ k = 8) :
    Kernel.Prefixes SymColl.prog SymColl.kern (L k) (c k) (g0 k) (fun _ => 1) (T k) (P k) := by
  have hb : blockWarps (L k) 0 = [0] := by rcases hk with rfl | rfl <;> decide
  have hg : volume (L k).grid = 1 := by rcases hk with rfl | rfl <;> rfl
  obtain ⟨-, hL, hE, hB⟩ := phases k hk
  refine ⟨fun n => rfl, rfl, fun b hb' i hi => ?_, hL, hE, hB⟩
  obtain rfl : b = 0 := by omega
  obtain rfl : i = 0 := Nat.lt_one_iff.1 hi
  refine ⟨0, by decide, 0, 1, fun w hw t m₀ ht hm₀ => ?_⟩
  obtain rfl : w = 0 := by simp only [hb, List.length_cons, List.length_nil] at hw; omega
  simp only [hb, List.getElem_cons_zero] at ht ⊢
  subst hm₀
  exact seg_to k hk t ht

/-- **SymColl's kernel runs to a done grid by `Kernel.run_of_phases`**, at one block of 4 and of
8 threads (`SymChain.L k`), no arguments, on the empty memory, at the address choice and oracle 0:
the start's grid `g0 k` steps (`Grid.Step`) to a done grid (`GPUProof.Done` at `sig`) whose memory
is the one past the barrier, `(ph k 1).2` (`P k 1 0 0`), with no end checks. The phases by
`phases`. -/
theorem run (k : Nat) (hk : k = 4 ∨ k = 8) :
    ∃ z, Relation.ReflTransGen (Grid.Step (L k) (c k)) (g0 k) z ∧
      GPUProof.Done sig (z, L k, c k) ∧ z.mem = (ph k 1).2 := by
  have hg : volume (L k).grid = 1 := by rcases hk with rfl | rfl <;> rfl
  have ⟨hW, hL, hE, hB⟩ := phases k hk
  obtain ⟨z, hz, hd, hP⟩ := Kernel.run_of_phases (start_eq k hk)
    (by rw [block k hk]; rcases hk with rfl | rfl <;> decide) (J := fun _ => 1) (fun n => rfl)
    rfl hW hL hE hB
  rw [hg] at hP
  exact ⟨z, hz, hd, hP⟩

/-- **SymColl's kernel is sound by `Kernel.sound_of_prefixes`**, at one block of 4 and of 8 threads
(`SymChain.L k`, `launch2 1 1 k 1`, one warp), no arguments, on the empty memory, at the one
admitted address choice and oracle (`adm0`), with the observation of the blocks: at the end the
trace has no data race and keeps the promise of `!invariant.load` (SymChain's `checks`, on the
trace whose one event is the barrier), and the blocks are the start's (`blocks_end`: one live
shared block of size 0 owned by block 0, the kernel writes no memory). One barrier (`J = 1`),
the phases by `prefixes` (the one to the barrier from `seg_to`, nothing past it). -/
theorem sound (k : Nat) (hk : k = 4 ∨ k = 8) :
    Kernel.Sound SymColl.prog SymColl.kern (L k) [] {} adm0 (fun m => some m.blocks)
      fun y => y = (g0 k).mem.blocks := by
  have hs := start_eq k hk
  have hg : volume (L k).grid = 1 := by rcases hk with rfl | rfl <;> rfl
  refine Kernel.sound_of_prefixes (fun _ _ _ _ _ hc => by cases hc)
    (by rw [block k hk]; rcases hk with rfl | rfl <;> decide)
    (fun ch oracle ⟨hch, ho⟩ => ⟨_, _, by subst hch ho; exact hs⟩)
    (fun _ _ h => congrArg some h) (fun ch oracle g c' ⟨hch, ho⟩ h => ?_)
  subst hch ho
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Except.ok.inj (h.symm.trans hs))
  refine ⟨fun _ => 1, T k, P k, prefixes k hk, fun m' hm' => ?_⟩
  rw [hg] at hm'
  subst hm'
  have hC := checks k hk _ rfl
  exact ⟨hC.1, hC.2, _, rfl, blocks_end k hk⟩

/-- **The twin: a barrier at another number is refused**, at 4 and at 8 threads: for every barrier
word `bar ≠ 0`, block, position, thread and memory predicates, the warp from the start's threads
on the start's memory has no `WarpSegsTo` at `bar`. Lane 0's first wait is the one `waits`
computes (`ToWait.det`), the barrier call on the word 0: with no shuffle before the barrier its
word is not `bar`, and with one the wait is not a shuffle (`Piece.Wait.shflOk`). -/
theorem bar_other_to (k : Nat) (hk : k = 4 ∨ k = 8) {bar l p : Nat} (hbar : bar ≠ 0)
    (V : Nat → Thread → Prop) (Q : Mem → Prop) :
    ¬ WarpSegsTo SymColl.prog SymColl.kern (L k) (c k) 0 (ph k 0).1 (ph k 0).2 bar l p V Q := by
  rintro ⟨J, lbl, mo, pos, ofs, cl, X, d, us, M, hM, -, hr, hok, -, -, -, -, hB, -⟩
  have h0 : 0 ∈ warpLanes (L k) 0 :=
    lanes k hk ▸ List.mem_range.2 (by rcases hk with rfl | rfl <;> omega)
  have hr0 := hr 0 h0
  rw [List.range_succ_eq_map, List.map_cons, hM] at hr0
  obtain ⟨u, i, xs, e, m₁, hw, ⟨-, hi, hxs, -⟩, -⟩ := hr0
  obtain ⟨s, m', hw', rfl, rfl⟩ :=
    waits k hk 0 (by omega) 0 (by rw [size k hk]; rcases hk with rfl | rfl <;> omega) _ _ rfl rfl
  obtain ⟨e₁, -⟩ := ToWait.det hw hw'
  obtain ⟨-, rfl, rfl, -⟩ := Status.wait.inj e₁
  rcases Nat.eq_zero_or_pos J with rfl | hJ0
  · obtain ⟨-, -, ⟨x, hx, hxw⟩, -, -⟩ := hB 0 h0
    obtain rfl := (List.cons.inj (hxs.trans hx)).1
    have h00 : (Val.bits 32 0).word? = some 0 := rfl
    rw [h00] at hxw
    exact hbar (Option.some.inj hxw).symm
  · have h := hok 0 h0
    simp only [Piece.Wait.shflOk, List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
    have h' := hi.trans (congrArg Coll.intr (h 0 hJ0).1)
    cases h'

/-- **The twin: a barrier at another number is refused**, at 4 and at 8 threads: for every barrier
word `bar ≠ 0`, block, position, thread and memory predicates, the warp from the start's threads
on the start's memory has no `WarpSegsBar` at `bar`: it would give a `WarpSegsTo` there
(`WarpSegsBar.to`), which `bar_other_to` refuses. -/
theorem bar_other (k : Nat) (hk : k = 4 ∨ k = 8) {bar l p : Nat} (hbar : bar ≠ 0)
    (V : Nat → Thread → Prop) (Q : Mem → Prop) :
    ¬ WarpSegsBar SymColl.prog SymColl.kern (L k) (c k) 0 (ph k 0).1 (ph k 0).2 bar l p V Q :=
  fun h => bar_other_to k hk hbar V Q h.to

end MojoProofTest.KernelPhases
