import MojoProof.Kernels.Formats

/-!
# The elementwise kernels at every float format: the equations and the corpus instances

`Program.retype t` and `Func.retype` (MojoProof/Sym/Formats.lean) give each elementwise kernel at
float format `t`; `vadd.family`, `vmul.family` and `vsub.family` (MojoProof/Kernels/Formats.lean)
are their kernel theorems for every `t`.
Checked here by the kernel:

* At `.float` the retyping is the identity on the three corpus programs, functions and paths,
  each kernel's bytes (`vadd.bytes`, `vmul.bytes`, `vsub.bytes`) are `Elem.map2` of its operation
  at `.float` (MojoProof/Sym/Kernel.lean), and each kernel theorem at Float32 (`vadd.correct`,
  `vmul.correct`, `vsub.correct`, generated by `mojo_kernel`) is the family theorem at `.float`
  (one `exact` each; the generated theorems stay as `mojo_kernel` generates them).
* At `.half` and `.bfloat`, `vector_addition`'s function retyped is the function of
  tests/corpus/vadd16/ and tests/corpus/vaddbf16/ (`v16`, `vb16`) with the Float32 kernel's name,
  and the programs' layouts are equal, and so are their intrinsics, globals, attribute groups,
  the declarations the kernel calls, and the kernels' checks. The programs differ in their
  modules (the kernel's name), digests and lists of kernels, so the family theorem at `.half` is
  not a theorem about `v16.prog`: no theorem here transports it (docs/proofs/elementwise.md
  plans one).
* `v16.correct` and `vb16.correct`: the kernel theorems at the two files' own programs, generated
  by `mojo_kernel` on each file with the `map2` clause at `.half` (`.bfloat`) and the bytes
  `Elem.map2` of `Model.add` at that format. They are generated at those files (the paths, the
  covers and each thread's `Ret` by mojo_ret at each file) and not derived from the family
  theorem. They cover these two files.
-/

namespace MojoProofTest

open MojoProof MojoProof.LLVM MojoProof.Sem MojoProof.Sym MojoProof.Kernels TorchLean
open FloatLib.Floats.Formats.BinaryInterchange

example : vadd.prog.retype .float = vadd.prog := rfl
example : vadd.fn_0.retype vadd.prog.layout .float = vadd.fn_0 := rfl
example : Paths.retype .float vadd.paths = vadd.paths := rfl
example : vmul.prog.retype .float = vmul.prog := rfl
example : vmul.fn_0.retype vmul.prog.layout .float = vmul.fn_0 := rfl
example : Paths.retype .float vmul.paths = vmul.paths := rfl
example : vsub.prog.retype .float = vsub.prog := rfl
example : vsub.fn_0.retype vsub.prog.layout .float = vsub.fn_0 := rfl
example : Paths.retype .float vsub.paths = vsub.paths := rfl

example (ω : Nat → Nat → Nat) {N : Nat} (x y : Tensor (Model LLVM.FloatTy.float.fmt) [N]) :
    vadd.bytes ω x y =
      Elem.map2 vadd.prog.layout .float Model.add (fun k => ω k (Nat.pair 23 0) / 3) x y := rfl
example (ω : Nat → Nat → Nat) {N : Nat} (x y : Tensor (Model LLVM.FloatTy.float.fmt) [N]) :
    vmul.bytes ω x y =
      Elem.map2 vmul.prog.layout .float Model.mul (fun k => ω k (Nat.pair 23 0) / 3) x y := rfl
example (ω : Nat → Nat → Nat) {N : Nat} (x y : Tensor (Model LLVM.FloatTy.float.fmt) [N]) :
    vsub.bytes ω x y =
      Elem.map2 vsub.prog.layout .float Model.sub (fun k => ω k (Nat.pair 23 0) / 3) x y := rfl

-- The three Float32 kernel theorems from the family theorems at `.float`.
example : type_of% @vadd.correct := by
  intro L hL hg hb al hal a b out n N x y m hP ω
  exact vadd.family .float hL hg hb hal hP
example : type_of% @vmul.correct := by
  intro L hL hg hb al hal a b out n N x y m hP ω
  exact vmul.family .float hL hg hb hal hP
example : type_of% @vsub.correct := by
  intro L hL hg hb al hal a b out n N x y m hP ω
  exact vsub.family .float hL hg hb hal hP

mojo_import "vadd16/vector_addition_vector_addition_vector_addition6A6A_b15c0625d18bfb81.nvptx.ll"
  as v16

mojo_import "vaddbf16/vector_addition_vector_addition_vector_addition6A6A_de5bc266e6b76899.nvptx.ll"
  as vb16

example : { vadd.fn_0.retype vadd.prog.layout .half with name := v16.fn_0.name } = v16.fn_0 := rfl
example : (vadd.prog.retype .half).layout = v16.prog.layout := rfl
example : { vadd.fn_0.retype vadd.prog.layout .bfloat with name := vb16.fn_0.name } = vb16.fn_0 :=
  rfl
example : (vadd.prog.retype .bfloat).layout = vb16.prog.layout := rfl

-- The other reads of the start and the steps agree too (docs/proofs/elementwise.md, its plan):
-- the intrinsics, globals and attribute groups, the declarations after the kernel (the
-- functions the kernel calls, each a declaration), and each kernel's check.
example : v16.prog.intrinsics = (vadd.prog.retype .half).intrinsics := rfl
example : v16.prog.module.globals = (vadd.prog.retype .half).module.globals := rfl
example : v16.prog.module.attrGroups = (vadd.prog.retype .half).module.attrGroups := rfl
example : v16.prog.module.funcs.toList.tail = (vadd.prog.retype .half).module.funcs.toList.tail :=
  rfl
example : (vadd.fn_0.retype vadd.prog.layout .half).callees =
    v16.prog.module.funcs.toList.tail.map (Callee.fn ·.name) := rfl
example : v16.prog.module.funcs.toList.tail.all (·.blocks.isEmpty) = true := rfl
example : v16.fn_0.check v16.prog.module = .ok () := by rfl
example : (vadd.fn_0.retype vadd.prog.layout .half).check (vadd.prog.retype .half).module =
    .ok () := by rfl
example : vb16.prog.intrinsics = (vadd.prog.retype .bfloat).intrinsics := rfl
example : vb16.prog.module.globals = (vadd.prog.retype .bfloat).module.globals := rfl
example : vb16.prog.module.attrGroups = (vadd.prog.retype .bfloat).module.attrGroups := rfl
example : vb16.prog.module.funcs.toList.tail =
    (vadd.prog.retype .bfloat).module.funcs.toList.tail := rfl
example : (vadd.fn_0.retype vadd.prog.layout .bfloat).callees =
    vb16.prog.module.funcs.toList.tail.map (Callee.fn ·.name) := rfl
example : vb16.prog.module.funcs.toList.tail.all (·.blocks.isEmpty) = true := rfl
example : vb16.fn_0.check vb16.prog.module = .ok () := by rfl
example : (vadd.fn_0.retype vadd.prog.layout .bfloat).check (vadd.prog.retype .bfloat).module =
    .ok () := by rfl

-- The kernel theorems at the f16 and bf16 files' own programs, generated at those files.
set_option mojo_kernel.share true in
mojo_kernel v16 := MojoProofTest.v16.prog MojoProofTest.v16.fn_0
  reads a := a0, b := a1
  writes out := a2
  scalars n := a3
  map2 (.fp .half) (Val.ofFloat .half)
    (fun ω => Elem.map2 v16.prog.layout .half Model.add (fun k => ω k (Nat.pair 23 0) / 3))

set_option mojo_kernel.share true in
mojo_kernel vb16 := MojoProofTest.vb16.prog MojoProofTest.vb16.fn_0
  reads a := a0, b := a1
  writes out := a2
  scalars n := a3
  map2 (.fp .bfloat) (Val.ofFloat .bfloat)
    (fun ω => Elem.map2 vb16.prog.layout .bfloat Model.add (fun k => ω k (Nat.pair 23 0) / 3))

end MojoProofTest
