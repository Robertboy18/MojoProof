import MojoProofTest.KernelCmd
import MojoProofTest.Kernel

/-!
# The kernel theorem for a kernel whose thread runs a loop, generated by `mojo_kernel`

The counting loop of MojoProofTest/SymLoop.lean (`for i in [0, n): p[i] = i`, the blocks of
`cnt`) as a kernel `cntK` whose parameters are `%n` (an `i64`) and `%p` (a plain pointer of
address space 1), so that the start's frame holds them (`cnt` has no parameters, so no frame
`Grid.start` makes holds its `%n` and `%p`).

* `cntK`, `cntKP`: the kernel and its program.
* The invariant lemmas, for every function with `cnt`'s blocks and every context whose program
  has `cntP`'s layout, proved once (SymLoop's `invN_entry`, `invN_step` and `invN_exit` are about
  `cnt` itself): `stmt_blocks` (such a function's statements are `cnt`'s), `body_blocks` (the
  body's values), `enter_blocks` (the edge into the header), the trace of the stores `cellTr`,
  the invariant `invB` (SymLoop's `invN` with the trace: the stores of cells `j < i` on the
  entry's trace), and `invB_entry`, `invB_step`, `invB_exit`.
* `loopK`: `mojo_kernel` on `cntK` with the `scalars` clause for `%n`, the `pointers` clause for
  `%p` and the loop clause at header 1, with the precondition `preB` (`%n = nOf V` at most
  `2 ^ 60`, `%p` at offset 0 of block `bOf V`, room for the cells), the invariant `invV`
  (`invB` at the entry valuation's context, bound, block and trace), the trip count `nOf` and the
  postcondition `postB` (cell `j` holds `j` for `j < nOf V`, and the trace is the entry's with
  the `nOf V` stores), and a tactic of 10 lines that closes the four obligations by `invB_entry`,
  `invB_step` and `invB_exit`. It generates the arguments `loopK.args n p` (`%n` as a bit vector,
  `%p` as `.ptr ⟨p, 0⟩`), the start `loopK.starts`, the thread's run `loopK.loop` and the kernel
  theorem through the loop (`n.sound_loop` for `n = loopK`) on `loopK.args` (`Kernel.Sound`)
  from `Mem.Closed`, an invariant indexed by the number of threads done, each thread's
  precondition from the start's facts and the registers `%n` and `%p` holding the arguments, and
  the end's check, for every launch, arguments, memory, admission, observation and predicate.
  With `mojo_kernel.share`, its summaries, paths and chains are those of `cntk`
  (MojoProofTest/KernelCmd.lean): SymLoop's `cntE`, `cntH`, `cntB`, `Kernels.vadd.b3`.
* Two loops in sequence: `cnt2k`, `mojo_kernel` on SymLoop's `cnt2` with a loop clause for each
  of its loops (headers 1 and 4), each from one valuation (`V2`, `frame2`'s entry valuation on
  `out3`, then the first loop's at its trip count), with the iterates of a round (`round1`,
  `round2`) as the invariant, trip count 2, the cells of both blocks (`cells22`) as the
  postcondition, and a tactic of 8 lines per clause. `cnt2k_retLs` is SymLoop's `cnt2_retLs` by
  the generated `cnt2k.loop`. `order_twin` (the clauses in the other order) and `cnt2_open` (a
  second clause whose tactic closes only the path into its loop) check the messages.
* `outC_closed`: SymLoop's `outC` (one global writable block of three `i64` cells) is closed for
  `loopK.args 3 outC.2` (`Mem.Closed.alloc`). `runK`, `frK`: the start on `Launch.one`, those
  arguments and `outC` at address choice `ch₀` and oracle `ω₀` (MojoProofTest/Kernel.lean),
  evaluated, and its one thread's frame (for `trip_twin`).
* `cells3`, `invK`, `endK`: cells 0 to 2 of `outC`'s block hold 0 to 2; the invariant (before
  the thread, `outC`'s blocks and an empty trace; after it, a memory of the postcondition `postB`
  from a valuation of thread 0 with `%n = 3`, `%p` at `outC`'s block and an empty trace); the
  end's facts from `invK` (no data race, `kept`, `cells3`).
* `kernelK`: **the kernel theorem** (`Kernel.Sound`) for `cntK` on `Launch.one` with
  `loopK.args 3 outC.2` and `outC`, at the admission of `ch₀` and `ω₀`, for the observation of the
  blocks and `cells3`: `loopK`'s kernel theorem through the loop with `outC_closed` and `invK`,
  the thread's precondition from the registers `%n` and `%p` the premise gives and `outC`'s
  block in its memory, nothing of the start evaluated. An `example` after it leaves the
  per-thread premise open and checks the goal that this theorem leaves (`#guard_msgs`).
* `trip_twin`: the premises of a fourth round fail (`%i = 3` is not below `%n = 3`), so the loop
  runs 3 rounds at `%n = 3`.

The invariant lemmas cover every function with `cnt`'s blocks and every bound, block and memory
of their premises; `loopK`'s kernel theorem through the loop covers the one kernel `cntK` at every
launch, argument, memory, admission and observation of its premises; `kernelK` and `trip_twin`
cover one program (`cntKP`), one launch (`Launch.one`), the arguments `loopK.args 3 outC.2`, the
memory `outC`, the address choice `ch₀` and the oracle `ω₀`. `cnt2k.loop` covers the one function
`cnt2` at every valuation of the first clause's precondition, which is the one valuation `V2`.
-/

namespace MojoProofTest.KernelLoop

open MojoProof MojoProof.LLVM MojoProof.Sem MojoProof.Sym
open MojoProofTest.SymLoop (cnt cntP outC cntE cntH cntB bodyC exitC Cells Cells.check
  Cells.store Cells.load cnt_gep cnt_store cntP_ptr cntP_size slt_ofNat hdr_vals hdr_after
  after_regs hdr_into cnt_round cnt2 cnt2P ctx2 out2 out3 frame2 c2H c2B c2M c2G c2D cell2
  run_ok)
open MojoProofTest.KernelCmd (nOf bOf cntPost)
open MojoProofTest.Kernel (ch₀ ω₀)

/-- The counting loop as a kernel: `cnt`'s blocks with the parameters `%n` (an `i64`, register 7)
and `%p` (a pointer in address space 1, register 8). -/
def cntK : Func := { cnt with params := [⟨.int 64, [], some 7⟩, ⟨.ptr 1, [], some 8⟩] }

/-- The program of `cntK` alone. -/
def cntKP : Program := .ofFunc cntK

/-! ## The invariant lemmas, for every function with `cnt`'s blocks -/

/-- The statements of a valuation whose function has `cnt`'s blocks are `cnt`'s, at every block
and position. -/
theorem stmt_blocks {W : Valuation} (hfn : W.fn.blocks = cnt.blocks) (l pc : Nat) :
    W.stmt l pc = ({ W with fn := cnt } : Valuation).stmt l pc := by
  simp only [Valuation.stmt, hfn]

/-- The body's node values at every valuation of a function with `cnt`'s blocks in a context
whose program has `cntP`'s layout, with `%i = i` (`i < 2 ^ 60`) and `%p` at offset 0 of block `b`
(not the null block) of address space 1: the increment `i + 1` and the address of cell `i`,
offset `8 i` (SymLoop's `body_vals` at such a function). -/
theorem body_blocks {W : Valuation} (hfn : W.fn.blocks = cnt.blocks)
    (hP : W.ctx.prog.layout = cntP.layout) {i b : Nat} {blk : Sem.Block}
    (h4 : W.regs 4 = some (.bits 64 (BitVec.ofNat 64 i))) (h8 : W.regs 8 = some (.ptr ⟨b, 0⟩))
    (hb : W.mem.blocks b = some blk) (hb0 : b ≠ 0) (hsp : blk.space = 1) (hi : i < 2 ^ 60) :
    vals W cntB.nodes =
      [.ok (.bits 64 (BitVec.ofNat 64 (i + 1))), .ok (.ptr ⟨b, 8 * (i : Int)⟩)] := by
  delta cntB
  have hg := (stmt_blocks hfn 2 1).trans (cnt_gep (W := { W with fn := cnt }) rfl)
  simp [vals, SNode.eval, SVal.eval, h4, h8, hg, lanes2,
    intBin, intBits, bind, Except.bind, pure, Except.pure, MojoProof.Sem.gep, gepPtr, hP,
    cntP_ptr, gepSteps, gepSteps.into, Mem.addr, Mem.block, hb, hb0, hsp, cntP_size,
    BitVec.toInt_ofNat_of_lt (w := 64) (k := i) (by omega), outS]
  refine ⟨?_, ?_⟩
  · rw [ite_eq_right (by omega)]
    congr 1
    apply BitVec.eq_of_toNat_eq
    simp
  · rw [Int.bmod_eq_of_le (n := (i : Int) * 8) (m := 18446744073709551616) (by omega) (by omega)]
    exact Int.mul_comm _ _

/-- The edge into the header from the entry (`phi` operand the constant 0) or from the body
(`%inext`), for every scope and frame of a function with `cnt`'s blocks: `enter` sets `%i` to the
operand's value and enters at position 1. -/
theorem enter_blocks {s : Scope} {F : Frame} (hfn : F.fn.blocks = cnt.blocks) {v : Value}
    (hv : F.label = 0 ∧ v = .int 0 ∨ F.label = 2 ∧ v = .loc 5) {x : Val}
    (hx : evalV s (.int 64) v = .ok x) :
    enter s F 1 = .ok { F.set (some 4) (some x) none with label := 1, pc := 1 } := by
  rcases hv with ⟨hl, rfl⟩ | ⟨hl, rfl⟩ <;>
    simp [enter, hfn, hl, cnt, Stmt.checkMd, hx, pure, Except.pure, bind, Except.bind]

/-- The trace of the loop's stores to cells `j < i` of block `b` by thread `w`, newest first:
each a write of the 8 bytes at offset `8 j`. -/
def cellTr (w : Who) (b : Nat) : Nat → List Event
  | 0 => []
  | i + 1 => .access ⟨w, ⟨b, 8 * (i : Int)⟩, 8, true, none, false⟩ :: cellTr w b i

/-- The invariant of round `i` for the bound `n`, the block `b` and the entry's trace `tr`, in
context `c`: the valuation is in `c` and in a function with `cnt`'s blocks, `%i = i`, `%n = n`,
`%p` at offset 0 of `b`, `Cells c.who n b i`, and the trace is `tr` with the stores to cells
`j < i` (`cellTr`). -/
def invB (c : Ctx) (n b : Nat) (tr : List Event) (i : Nat) (W : Valuation) : Prop :=
  W.ctx = c ∧ W.fn.blocks = cnt.blocks ∧ W.regs 4 = some (.bits 64 (BitVec.ofNat 64 i)) ∧
    W.regs 7 = some (.bits 64 (BitVec.ofNat 64 n)) ∧ W.regs 8 = some (.ptr ⟨b, 0⟩) ∧
    Cells c.who n b i W.mem ∧ W.mem.trace = cellTr c.who b i ++ tr

/-- **The invariant's preservation**, for every context `c` whose program has `cntP`'s layout,
bound `n ≤ 2 ^ 60`, block `b`, trace `tr`, round `i < n` and valuation `W` of `invB c n b tr i`:
the round's premises hold at `W` (`Round`: the header's comparison is true, the body's obligations
hold, its edge goes to the header at position 1), and `invB c n b tr (i + 1)` holds after it (the
store of cell `i`, `Cells.store`, logged on the trace, `Mem.store_of_check`). -/
theorem invB_step {c : Ctx} (hP : c.prog.layout = cntP.layout) {n b : Nat} {tr : List Event}
    (hn : n ≤ 2 ^ 60) {i : Nat} (hi : i < n) {W : Valuation} (h : invB c n b tr i W) :
    Round 1 1 cntH.obls cntH bodyC W ∧
      invB c n b tr (i + 1) (Valuation.round 1 cntH bodyC W) := by
  obtain ⟨hc, hfn, h4, h7, h8, hm, htr⟩ := h
  obtain ⟨m', hst, hm'⟩ := Cells.store hm hi hn
  obtain ⟨hb0, blk, hb, hs, hl, hr, hw, hsz, ha, -⟩ := hm
  have htr' : m'.trace = .access ⟨c.who, ⟨b, 8 * (i : Int)⟩, 8, true, none, false⟩ ::
      W.mem.trace := by
    have hbs : cntP.layout.encode (.int 64) (.bits 64 (BitVec.ofNat 64 i)) =
        some (leBytes 8 i) := by
      simp [Layout.encode]
      rw [Nat.mod_eq_of_lt (by omega)]
    have h' := hst
    rw [Mem.store_of_check hbs (Cells.check hb0 hb hs hl hw hsz ha hi) hr] at h'
    cases h'
    simp [Mem.log, Mem.set, leBytes]
  have hH := hdr_vals h4 h7
  have hslt := slt_ofNat hi (by omega)
  obtain ⟨hc1, hf1, hm1, hr1⟩ := hdr_after W
  have hf1' : (W.after cntH).fn.blocks = cnt.blocks := by rw [hf1]; exact hfn
  have hB := body_blocks (W := W.after cntH) hf1' (by rw [hc1, hc]; exact hP)
    (by rw [hr1 4 (by decide)]; exact h4) (by rw [hr1 8 (by decide)]; exact h8)
    (by rw [hm1]; exact hb) hb0 hs (by omega)
  have hrun : SEff.run (W.after cntH) (vals (W.after cntH) cntB.nodes) cntB.effs = .ok m' := by
    rw [hB]
    delta cntB
    simp [SEff.run, SEff.apply, (stmt_blocks hf1' 2 2).trans
      (cnt_store (W := { W.after cntH with fn := cnt }) rfl), SVal.eval,
      hr1 4 (by decide), h4, hc1, hc, hP, Val.addr?, hm1]
    exact hst
  have hE := Valuation.into_of_enter (V := W.after cntH) (l := 2) (S := cntB) rfl rfl
    (enter_blocks (s := (W.after cntH).ctx.scope ((W.after cntH).after cntB).mem
        ((W.after cntH).frameAt 2 cntB) ((W.after cntH).k + cntB.len))
      (F := (W.after cntH).frameAt 2 cntB) hf1' (.inr ⟨rfl, rfl⟩)
      (x := .bits 64 (BitVec.ofNat 64 (i + 1)))
      (by
        simp only [evalV, Ctx.scope, Valuation.frameAt, Valuation.frameAtWith, Valuation.afterWith,
          after_regs, hB]
        delta cntB
        simp [regVal, List.lookup, SVal.eval, pure, Except.pure, Except.toOption]))
  refine ⟨⟨⟨?_, ?_, ?_⟩, ?_, ?_⟩, ?_⟩
  · rw [hH]
    delta cntH
    simp [Cond.Holds, SVal.eval, SEff.run, hslt, Val.ofBool, pure, Except.pure]
  · rw [hH]
    delta cntH
    simp [Exit.dest, Exit.target, SVal.eval, hslt, Val.ofBool]
  · rw [show W.intoWith false 1 cntH = W.after cntH from hdr_into W]
    intro d hd
    delta cntB at hd
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hd
    rcases hd with rfl | rfl | rfl | rfl
    · exact ⟨_, by rw [hB]; rfl⟩
    · exact ⟨m', hrun⟩
    · exact ⟨_, by rw [hB]; rfl⟩
    · exact ⟨_, by rw [hB]; rfl⟩
  · rfl
  · show phiCount W.fn 1 = 1
    rw [phiCount, hfn]
    rfl
  · rw [cnt_round, hE]
    refine ⟨hc1.trans hc, hf1', by simp [Frame.set], ?_, ?_, ?_, ?_⟩
    · simp only [Frame.set, Valuation.frameAt, Valuation.frameAtWith, Valuation.afterWith,
        after_regs]
      delta cntB
      simp [regVal, List.lookup]
      rw [hr1 7 (by decide)]
      exact h7
    · simp only [Frame.set, Valuation.frameAt, Valuation.frameAtWith, Valuation.afterWith,
        after_regs]
      delta cntB
      simp [regVal, List.lookup]
      rw [hr1 8 (by decide)]
      exact h8
    · show Cells c.who n b (i + 1) ((SEff.run (W.after cntH) (vals (W.after cntH) cntB.nodes)
        cntB.effs).toOption.getD _)
      rw [hrun]
      exact hm'
    · show ((SEff.run (W.after cntH) (vals (W.after cntH) cntB.nodes)
        cntB.effs).toOption.getD _).trace = _
      rw [hrun]
      show m'.trace = _ :: (cellTr c.who b i ++ tr)
      rw [htr', htr]

/-- **The exit**, for every context `c`, bound `n ≤ 2 ^ 60`, block `b`, trace `tr` and valuation
of `invB c n b tr n`: the exit path's premises hold (the header's comparison `n < n` is false),
its last exit is `ret`, and its memory has `j` in cell `j` for every `j < n` and the trace `tr`
with the `n` stores. -/
theorem invB_exit {c : Ctx} {n b : Nat} {tr : List Event} (hn : n ≤ 2 ^ 60) {W : Valuation}
    (h : invB c n b tr n W) :
    WalkWith false W ((1, cntH.obls, cntH) :: exitC) ∧
      (W.lastWith false 1 cntH exitC).2.2.exit = .ret ∧
      ∃ me, SEff.run (W.lastWith false 1 cntH exitC).1
          (vals (W.lastWith false 1 cntH exitC).1 (W.lastWith false 1 cntH exitC).2.2.nodes)
          (W.lastWith false 1 cntH exitC).2.2.effs = .ok me ∧
        (∀ j < n, me.load cntP.layout c.who 1 (.int 64) ⟨b, 8 * j⟩ (some 8) =
          .ok (.bits 64 (BitVec.ofNat 64 j))) ∧ me.trace = cellTr c.who b n ++ tr := by
  obtain ⟨-, -, h4, h7, -, hm, htr⟩ := h
  have hH := hdr_vals h4 h7
  obtain ⟨-, -, hm1, -⟩ := hdr_after W
  refine ⟨⟨?_, ?_, fun d hd => ?_⟩, rfl, W.mem, by rw [← hm1]; rfl,
    fun j hj => Cells.load hm hn hj, htr⟩
  · rw [hH]
    delta cntH
    simp [Cond.Holds, SVal.eval, SEff.run, Val.ofBool, pure, Except.pure]
  · rw [hH]
    delta cntH
    simp [Exit.dest, Exit.target, SVal.eval, Val.ofBool, BitVec.slt]
  · change d ∈ Kernels.vadd.b3.obls at hd
    delta Kernels.vadd.b3 at hd
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hd
    subst hd
    exact ⟨_, rfl⟩

/-- **The entry**, for every context `c`, bound `n`, block `b`, step count `k`, memory `m` of
`Cells c.who n b 0` and frame `f` of a function with `cnt`'s blocks with `%n = n` and `%p` at
`b`: the entry block's premises hold, its edge goes to the header at position 1, and
`invB c n b m.trace 0` holds at the header's entry valuation (`%i = 0`). -/
theorem invB_entry {c : Ctx} {n b k : Nat} {m : Mem} {f : Frame}
    (hfn : f.fn.blocks = cnt.blocks) (h7 : f.regs 7 = some (.bits 64 (BitVec.ofNat 64 n)))
    (h8 : f.regs 8 = some (.ptr ⟨b, 0⟩)) (hm : Cells c.who n b 0 m) :
    WalkWith false (Valuation.entry c k m f) [(0, cntE.obls, cntE)] ∧
      ((Valuation.entry c k m f).lastWith false 0 cntE []).2.2.exit.dest
        ((Valuation.entry c k m f).lastWith false 0 cntE []).1
        (vals ((Valuation.entry c k m f).lastWith false 0 cntE []).1
          ((Valuation.entry c k m f).lastWith false 0 cntE []).2.2.nodes) = some 1 ∧
      ((Valuation.entry c k m f).lastWith false 0 cntE []).2.2.exit.pc f.fn 1 = 1 ∧
      invB c n b m.trace 0 (Valuation.round 0 cntE [] (Valuation.entry c k m f)) := by
  have hE := Valuation.into_of_enter (V := Valuation.entry c k m f) (l := 0) (S := cntE) rfl rfl
    (enter_blocks (F := (Valuation.entry c k m f).frameAt 0 cntE) hfn (.inl ⟨rfl, rfl⟩)
      (x := .bits 64 (BitVec.ofNat 64 0)) rfl)
  have hR : Valuation.round 0 cntE [] (Valuation.entry c k m f) = _ := hE
  refine ⟨fun d hd => ?_, rfl, ?_, by rw [hR]; rfl, by rw [hR]; exact hfn,
    by rw [hR]; simp [Frame.set], ?_, ?_, ?_, by rw [hR]; rfl⟩
  · change d ∈ cntE.obls at hd
    delta cntE at hd
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hd
    rcases hd with rfl | rfl
    · exact ⟨_, rfl⟩
    · exact ⟨_, rfl⟩
  · show phiCount f.fn 1 = 1
    rw [phiCount, hfn]
    rfl
  · rw [hR]
    delta cntE
    simpa [Frame.set, Valuation.frameAt, Valuation.frameAtWith, Valuation.afterWith,
      Valuation.after, regVal, Valuation.entry] using h7
  · rw [hR]
    delta cntE
    simpa [Frame.set, Valuation.frameAt, Valuation.frameAtWith, Valuation.afterWith,
      Valuation.after, regVal, Valuation.entry] using h8
  · rw [hR]
    exact hm

/-! ## The kernel, by `mojo_kernel` with the pointer and loop clauses -/

/-- The precondition of the counting loop at its entry valuation `V`: `V`'s program has `cntP`'s
layout, its function has `cnt`'s blocks, `%n` is the `i64` `nOf V ≤ 2 ^ 60`, `%p` is at offset 0
of block `bOf V`, and that block has room for `nOf V` cells (`Cells` with no cell written). -/
def preB (V : Valuation) : Prop :=
  V.ctx.prog.layout = cntP.layout ∧ V.fn.blocks = cnt.blocks ∧ nOf V ≤ 2 ^ 60 ∧
    V.regs 7 = some (.bits 64 (BitVec.ofNat 64 (nOf V))) ∧ V.regs 8 = some (.ptr ⟨bOf V, 0⟩) ∧
    Cells V.ctx.who (nOf V) (bOf V) 0 V.mem

/-- The invariant of round `i` from entry valuation `V`: `invB` at `V`'s context, bound, block and
trace. -/
def invV (V : Valuation) : Nat → Valuation → Prop := invB V.ctx (nOf V) (bOf V) V.mem.trace

/-- The postcondition from entry valuation `V`: cell `j` of block `bOf V` holds the `i64` `j` for
every `j < nOf V` (`cntPost`), and the trace is `V`'s with the `nOf V` stores (`cellTr`). -/
def postB (V : Valuation) (me : Mem) : Prop :=
  cntPost V me ∧ me.trace = cellTr V.ctx.who (bOf V) (nOf V) ++ V.mem.trace

-- `loopK`: the counting loop as the kernel `cntK`, `%n` by the `scalars` clause and the plain
-- pointer `%p` by the `pointers` clause, with the loop clause at header 1; the tactic closes the
-- path into the loop and the invariant at round 0 by `invB_entry`, a round by `invB_step` and
-- the path out by `invB_exit`. With `mojo_kernel.share`, its summaries, paths and chains are
-- those of `cntk` (MojoProofTest/KernelCmd.lean).
set_option mojo_kernel.share true in
mojo_kernel loopK := cntKP cntK
  scalars n := a0
  pointers p := a1
  loop 1 := preB invV nOf postB by
    intro V hV
    obtain ⟨hP, hfn, hn, h7, h8, hm⟩ := hV
    first
      | obtain ⟨hW, hd, hpc, -⟩ := invB_entry (c := V.ctx) (k := V.k) (m := V.mem)
          (f := ⟨V.fn, 0, 0, V.regs, V.prods, [], none⟩) hfn h7 h8 hm
        exact ⟨hW, hd, hpc⟩
      | exact (invB_entry (c := V.ctx) (k := V.k) (m := V.mem)
          (f := ⟨V.fn, 0, 0, V.regs, V.prods, [], none⟩) hfn h7 h8 hm).2.2.2
      | (intro i hi W hW; exact invB_step hP hn hi hW)
      | (intro W hW; exact invB_exit hn hW)

/-! ## Two loops in sequence -/

/-- The entry valuation of `cnt2`'s thread at SymLoop's `frame2` on `out3`'s memory (`%n = 2`,
`%p` and `%s` at the two blocks). -/
def V2 : Valuation := Valuation.entry ctx2 0 out3.1 frame2

/-- A round of `cnt2`'s first loop (`1 → 2`) from its header's entry valuation. -/
def round1 : Valuation → Valuation := Valuation.round 1 c2H [(2, c2B.obls, c2B)]

/-- A round of `cnt2`'s second loop (`4 → 5`) from its header's entry valuation. -/
def round2 : Valuation → Valuation := Valuation.round 4 c2G [(5, c2D.obls, c2D)]

/-- Cells 0 and 1 of both of `out3`'s blocks hold 0 and 1 in memory `me`. -/
abbrev cells22 (me : Mem) : Prop :=
  ∀ j < 2, cell2 me out2.2 j = some j ∧ cell2 me out3.2 j = some j

-- `cnt2k`: a loop clause for each of `cnt2`'s two loops, in the order the thread runs them, each
-- from one valuation (`V2`, then the first loop's at its trip count), with the iterates of a
-- round as the invariant, trip count 2 and the cells as the postcondition. The tactic of each
-- clause evaluates the path into the loop and each round's premises (`decide +kernel`), and the
-- first clause's gives the second's precondition, the second's evaluates the path out to `ret`.
set_option mojo_kernel.share true in
mojo_kernel cnt2k := cnt2P cnt2
  loop 1 := (· = V2) (fun V i W => W = round1^[i] (Valuation.round 0 cntE [] V)) (fun _ => 2)
      (fun _ => cells22) by
    intro V hV
    subst hV
    first
      | decide +kernel
      | exact rfl
      | (intro i _ W hW; subst hW
         exact ⟨by revert i; decide +kernel, (Function.iterate_succ_apply' round1 i _).symm⟩)
      | (intro W hW; subst hW; exact ⟨rfl, fun _ h => h⟩)
  loop 4 := (· = round1^[2] (Valuation.round 0 cntE [] V2))
      (fun V i W => W = round2^[i] (Valuation.round 1 c2H [(3, c2M.obls, c2M)] V)) (fun _ => 2)
      (fun _ => cells22) by
    intro V hV
    subst hV
    first
      | decide +kernel
      | exact rfl
      | (intro i _ W hW; subst hW
         exact ⟨by revert i; decide +kernel, (Function.iterate_succ_apply' round2 i _).symm⟩)
      | (intro W hW; subst hW; refine ⟨?_, ?_, run_ok ?_⟩ <;> decide +kernel)

/-- **Two loops in sequence by `mojo_kernel`**: SymLoop's `cnt2_retLs` (the run of both loops
from `V2` to `ret`, with cells 0 and 1 of both blocks holding 0 and 1) is the generated
`cnt2k.loop` at `V2`, for the sequence of loops the command computes (`cnt2k.chains`). -/
theorem cnt2k_retLs : ∃ C ∈ cnt2k.chains, RetLs cells22 C.loops V2 C.l C.ds C.S C.E :=
  cnt2k.loop V2 rfl fun _ h => h

/--
error: mojo_kernel: the loop clauses need one path from the entry block to a loop, into the first clause's loop, and for each loop one round and one path out, into the next clause's loop or, after the last, to a ret; the entry block's path to a loop is not into the loop at block %hdr2 (block 4 of cnt2)
-/
#guard_msgs in
mojo_kernel order_twin := cnt2P cnt2
  loop 4 := (fun _ => True) (fun _ _ _ => True) (fun _ => 2) (fun _ _ => True)
  loop 1 := (fun _ => True) (fun _ _ _ => True) (fun _ => 2) (fun _ _ => True)

/--
error: mojo_kernel: the loop clauses' tactics do not close cnt2_open.init4 (the invariant at round 0), cnt2_open.step4 (a round), cnt2_open.exit4 (the path out); the command adds nothing
-/
#guard_msgs in
mojo_kernel cnt2_open := cnt2P cnt2
  loop 1 := (· = V2) (fun V i W => W = round1^[i] (Valuation.round 0 cntE [] V)) (fun _ => 2)
      (fun _ => cells22) by
    intro V hV
    subst hV
    first
      | decide +kernel
      | exact rfl
      | (intro i _ W hW; subst hW
         exact ⟨by revert i; decide +kernel, (Function.iterate_succ_apply' round1 i _).symm⟩)
      | (intro W hW; subst hW; exact ⟨rfl, fun _ h => h⟩)
  loop 4 := (· = round1^[2] (Valuation.round 0 cntE [] V2))
      (fun V i W => W = round2^[i] (Valuation.round 1 c2H [(3, c2M.obls, c2M)] V)) (fun _ => 2)
      (fun _ => cells22) by
    intro V hV
    subst hV
    decide +kernel

/-! ## The kernel theorem at one launch and memory -/

-- `Array.any` recurses by well-founded recursion, so `rfl` cannot evaluate a step without this
-- (after `loopK`, whose command unseals it for its own proofs).
unseal Array.anyM.loop

/-- The start's grid and contexts on `Launch.one`, `loopK.args 3 outC.2` (`%n = 3`, `%p` at
offset 0 of `outC`'s block) and `outC` at `ch₀` and `ω₀` (the empty grid if it faults). -/
def runK : Grid × (Nat → Ctx) :=
  match Grid.start cntKP cntK .one (loopK.args (BitVec.ofNat 64 3) outC.2) outC.1 ch₀ ω₀ with
  | .ok r => r
  | .error _ => (⟨#[], {}⟩, fun _ => SymRun.ctx0)

/-- The start's grid. -/
def gK : Grid := runK.1

/-- The start's contexts. -/
def cK : Nat → Ctx := runK.2

/-- The frame of the start's thread (`SymLoop.frameC 0` if it has none). -/
def frK : Frame := ((Grid.thread gK 0).frames.head?).getD (SymLoop.frameC 0)

/-- `outC` has no pointer byte. -/
theorem outC_bytesIn : outC.1.BytesIn outC.1.Known :=
  Mem.alloc_bytesIn (fun _ _ _ _ _ h => by cases h) (init := []) (fun _ _ h => by cases h)
    _ _ _ _ _ _ _ _ _ _

/-- Cells 0 to 2 of `outC`'s block in blocks `B` hold the `i64`s 0 to 2. -/
def cells3 (B : Nat → Option Sem.Block) : Bool := (List.range 3).all fun j =>
  match ({ blocks := B } : Mem).load cntKP.layout ⟨0, 0⟩ 1 (.int 64) ⟨outC.2, 8 * j⟩ (some 8) with
  | .ok (.bits _ x) => x.toNat == j
  | _ => false

/-- `outC` is closed for `loopK.args 3 outC.2`: one block allocated on the empty memory
(`Mem.Closed.alloc`), and the arguments name no block above it. -/
theorem outC_closed : outC.1.Closed (loopK.args (BitVec.ofNat 64 3) outC.2) :=
  Mem.closed_empty.alloc cntP.layout 1 24 8 true false .all 1 1 (fun _ _ h => by cases h)
    (by decide +kernel)

/-- The invariant by the number of threads done: before the thread, a memory with `outC`'s blocks
and an empty trace; after it, a memory of `postB V` for a valuation `V` of thread 0 with
`%n = 3` (`nOf`), `%p` at `outC`'s block (`bOf`) and an empty trace. -/
def invK : Nat → Mem → Prop
  | 0, m => (∀ b x, outC.1.blocks b = some x → m.blocks b = some x) ∧ m.trace = []
  | _ + 1, m => ∃ V : Valuation, V.ctx.who = ⟨0, 0⟩ ∧ nOf V = 3 ∧ bOf V = outC.2 ∧
      V.mem.trace = [] ∧ postB V m

/-- A load depends on the memory's blocks alone: memories with the same blocks load the same
value, for every layout, thread, address space, type, pointer and alignment. -/
theorem load_blocks {m m' : Mem} (h : m.blocks = m'.blocks) {l : Layout} {w : Who} {a : Nat}
    {t : Ty} {p : Ptr} {al : Option Nat} : m.load l w a t p al = m'.load l w a t p al := by
  simp only [Mem.load, Mem.check, Mem.block, Mem.addr, h]

/-- The end's check on `Launch.one`: every memory of `invK` after its one thread has a trace with
no data race that keeps the promise of `!invariant.load` (the three stores of `cellTr`, evaluated)
and blocks passing `cells3` (`postB`'s cells, read on the blocks alone, `load_blocks`). -/
theorem endK (m' : Mem) (h : invK (volume Launch.one.grid * volume Launch.one.block) m') :
    ((∀ a, Event.access a ∈ m'.trace →
        a.who.thread < volume Launch.one.grid * volume Launch.one.block ∧
          a.who.cta = a.who.thread / volume Launch.one.block) → Trace.Shaped m'.trace.reverse →
      GPUProof.racy sig (m'.trace.map (Event.toCore Launch.one)).reverse = false) ∧
      GPUProof.kept sig (m'.trace.map (Event.toCore Launch.one)).reverse = true ∧
      ∃ y, some m'.blocks = some y ∧
      cells3 y = true := by
  obtain ⟨V, hw, hn, hb, hT, hc, htr⟩ := (h : invK (0 + 1) m')
  rw [hw, hb, hn, hT] at htr
  refine ⟨fun _ _ => by rw [htr]; decide +kernel, by rw [htr]; decide +kernel, _, rfl, ?_⟩
  simp only [cells3, List.all_eq_true, List.mem_range]
  intro j hj
  have e : ({ blocks := m'.blocks } : Mem).load cntKP.layout ⟨0, 0⟩ 1 (.int 64)
      ⟨outC.2, 8 * j⟩ (some 8) = .ok (.bits 64 (BitVec.ofNat 64 j)) := by
    rw [load_blocks (m := { blocks := m'.blocks }) (m' := m') rfl, ← hb]
    have := hc j (by rw [hn]; exact hj)
    rwa [hw] at this
  rw [e]
  show ((BitVec.ofNat 64 j).toNat == j) = true
  simp only [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (show j < 2 ^ 64 by omega), beq_self_eq_true]

/-- **The kernel theorem for a kernel whose thread runs a loop** (`loopK.sound_loop`, generated by
`mojo_kernel` with the pointer and loop clauses). `cntK` on `Launch.one` with
`loopK.args 3 outC.2` (`%n = 3`, `%p` at offset 0 of `outC`'s block) and `outC`, at the admission
of `ch₀` and `ω₀` alone, is sound (`Kernel.Sound`) for the observation of the blocks and the
relation that cells 0 to 2 of `outC`'s block hold 0 to 2: `outC` is closed (`outC_closed`), the
invariant is `invK`, the precondition `preB` holds at every valuation with the start's facts
(the registers of `%n` and `%p`, `outC`'s block), and the postcondition `postB` is `invK` after
the thread, whose end's check is `endK`. It covers this one program, launch, memory, address
choice and oracle. -/
theorem kernelK : Kernel.Sound cntKP cntK .one (loopK.args (BitVec.ofNat 64 3) outC.2) outC.1
    (fun ch o => ch = ch₀ ∧ o = ω₀) (fun m => some m.blocks) (fun B => cells3 B = true) := by
  refine loopK.sound_loop _ _ outC_closed outC_bytesIn (fun _ _ h => congrArg some h) invK
    (fun _ => And.intro) (fun k hk V hp hw _ hf h7 h8 hI => ?_) endK
  obtain rfl : k = 0 := Nat.lt_one_iff.1 hk
  obtain ⟨hB, hT⟩ := hI
  have hn : nOf V = 3 := by unfold nOf; rw [h7]; rfl
  have hb : bOf V = outC.2 := by unfold bOf; rw [h8]
  exact ⟨⟨by rw [hp]; rfl, by rw [hf]; rfl, by rw [hn]; decide, by rw [hn]; exact h7,
    by rw [hb]; exact h8, by rw [hn, hb]; exact ⟨by decide, _, hB _ _ rfl, rfl, rfl, rfl, rfl,
      by decide, rfl, nofun⟩⟩, fun me h => ⟨V, by rw [hw, Nat.zero_div], hn, hb, hT, h⟩⟩

/--
error: unsolved goals
⊢ ∀ k < volume Launch.one.grid * volume Launch.one.block,
    ∀ (V : Valuation),
      V.ctx.prog = cntKP →
        V.ctx.who = { thread := k, cta := k / volume Launch.one.block } →
          V.ctx.env = Launch.one.env k →
            V.fn = cntK →
              V.regs 7 = some (Val.bits 64 3#64) →
                V.regs 8 = some (Val.ptr { block := outC.2, off := 0 }) →
                  invK k V.mem → preB V ∧ ∀ (me : Mem), postB V me → invK (k + 1) me
-/
#guard_msgs in
/-- The per-thread premise of `loopK.sound_loop` that `kernelK` proves, left open: for the one
thread of `Launch.one`, every valuation with the start's facts and a memory of `invK 0` meets
`preB`, and `postB` there gives `invK 1`. An `example`, so that no declaration with the open goal
enters the environment. -/
example : Kernel.Sound cntKP cntK .one (loopK.args (BitVec.ofNat 64 3) outC.2) outC.1
    (fun ch o => ch = ch₀ ∧ o = ω₀) (fun m => some m.blocks) (fun B => cells3 B = true) := by
  refine loopK.sound_loop _ _ outC_closed outC_bytesIn (fun _ _ h => congrArg some h) invK
    (fun _ => And.intro) ?_ endK

/-- **The twin of the trip count**: the premises of a fourth round fail from the third iterate of
the header's valuation (`%i = 3` is not below `%n = 3`), so the loop runs 3 rounds at `%n = 3`
(evaluated). -/
theorem trip_twin : ¬ Round 1 1 cntH.obls cntH bodyC ((Valuation.round 1 cntH bodyC)^[3]
    (Valuation.round 0 cntE [] (Valuation.entry (cK 0) 0 gK.mem frK))) := by
  decide +kernel

end MojoProofTest.KernelLoop
