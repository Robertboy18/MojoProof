                                    Mem.load naive.prog.layout m' c.who 0
                                          (Ty.struct
                                            [Ty.ptr 0,
                                              Ty.struct
                                                [Ty.struct [Ty.struct [], Ty.struct []],
                                                  Ty.struct [Ty.struct [], Ty.struct []]]])
                                          { block := q1, off := 0 } (some 8) =
                                        Except.ok
                                          (Val.agg
                                            [Val.ptr { block := bA, off := 0 },
                                              Val.agg
                                                [Val.agg [Val.agg [], Val.agg []], Val.agg [Val.agg [], Val.agg []]]]) →
                                      Mem.load naive.prog.layout m' c.who 0
                                            (Ty.struct
                                              [Ty.ptr 0,
                                                Ty.struct
                                                  [Ty.struct [Ty.struct [], Ty.struct []],
                                                    Ty.struct [Ty.struct [], Ty.struct []]]])
                                            { block := q2, off := 0 } (some 8) =
                                          Except.ok
                                            (Val.agg
                                              [Val.ptr { block := bB, off := 0 },
                                                Val.agg
                                                  [Val.agg [Val.agg [], Val.agg []],
                                                    Val.agg [Val.agg [], Val.agg []]]]) →
                                        f.regs 3 = some (Val.bits 32 (BitVec.ofNat 32 m)) →
                                          f.regs 4 = some (Val.bits 32 (BitVec.ofNat 32 n)) →
                                            f.regs 5 = some (Val.bits 32 (BitVec.ofNat 32 K)) →
                                              m'.Buffer bA (m * 768 * naive.prog.layout.size (Ty.fp FloatTy.float)) 4
                                                  false →
                                                m'.Buffer bB (n * 768 * naive.prog.layout.size (Ty.fp FloatTy.float)) 4
                                                    false →
                                                  m'.Buffer bC
                                                      (m * 50257 * naive.prog.layout.size (Ty.fp FloatTy.float)) 4
                                                      true →
                                                    Mem.Fits naive.prog.layout m' bA
                                                        (m * 768 * naive.prog.layout.size (Ty.fp FloatTy.float)) →
                                                      Mem.Fits naive.prog.layout m' bB
                                                          (n * 768 * naive.prog.layout.size (Ty.fp FloatTy.float)) →
                                                        Mem.Fits naive.prog.layout m' bC
                                                            (m * 50257 * naive.prog.layout.size (Ty.fp FloatTy.float)) →
                                                          Mem.Holds naive.prog.layout m' bA (Ty.fp FloatTy.float)
                                                              (Val.ofFloat FloatTy.float)
                                                              (rowMajor naive.prog.layout (Ty.fp FloatTy.float) 0) A →
                                                            Mem.Holds naive.prog.layout m' bB (Ty.fp FloatTy.float)
                                                                (Val.ofFloat FloatTy.float)
                                                                (rowMajor naive.prog.layout (Ty.fp FloatTy.float) 0) B →
                                                              Elem m₀ bC 4
                                                                  (fun k =>
                                                                    (L.index k Dim.x * 50257 + L.index k Dim.y) * 4)
                                                                  (bytes ω L K A B) k m' →
                                                                Elem.Only bC
                                                                    (fun k =>
                                                                      k < volume L.grid * volume L.block ∧
                                                                        L.index k Dim.x < m ∧ L.index k Dim.y < n)
                                                                    m' →
                                                                  ∃ ps ∈ [skipN],
                                                                    RetWith true (Valuation.entry c 0 m' f)
                                                                      (fun me =>
                                                                        Elem m₀ bC 4
                                                                            (fun k =>
                                                                              (L.index k Dim.x * 50257 +
                                                                                  L.index k Dim.y) *
                                                                                4)
                                                                            (bytes ω L K A B) (k + 1) me ∧
                                                                          Elem.Only bC
                                                                            (fun k =>
                                                                              k < volume L.grid * volume L.block ∧
                                                                                L.index k Dim.x < m ∧
                                                                                  L.index k Dim.y < n)
                                                                            me)
                                                                      ps
-/
#guard_msgs in
/-- The two premises of `naive.sound_mat` that the `mat` clause leaves to the user, as open
goals: at every launch valid with `z` sides 1, sizes, blocks, tensors and memory of `Mat.Pre` at
binary32, alignment 4 and strides 768, 768 and 50257, cell width 4 and the oracles `ω`, `Hin`
(a thread in bounds runs the chain `chainN` to `ret`) and `Hout` (a thread out of bounds takes
the path `skipN` to `ret`), each from the facts the start gives the thread. An `example`, so that
no declaration with the open goals enters the environment. -/
example {L : Launch} (hL : L.Valid) (hz : L.grid .z = 1 ∧ L.block .z = 1) {m n K bC bA bB : Nat}
    {A : Tensor (Model FloatTy.float.fmt) [m, 768]} {B : Tensor (Model FloatTy.float.fmt) [n, 768]}
    {mem : Mem} (h : Mat.Pre naive.prog.layout (.fp .float) (Val.ofFloat .float) 4 z mem bC bA bB
      m n K 768 768 50257 A B) {ω : Nat → Nat → Nat} :
    Kernel.Sound naive.prog naive.fn_0 L (Mat.args z bC bA bB m n K) mem (fun _ ω' => ω' = ω)
      (fun m => some m.blocks)
      (Elem.Out mem bC (cell L) (bytes ω L K A B) (volume L.grid * volume L.block)) := by
  refine naive.sound_mat (t := .fp .float) (w := 4) hL hz h.closed ⟨h.ne.1.symm, h.ne.2.1.symm⟩
    h.bufs h.x h.y h.le.1 h.fits ?Hin ?Hout

/-- error: mojo_kernel: mat needs a kernel of six parameters, three byval structs then three i32s; edgeF has 0 -/
#guard_msgs in
mojo_kernel edgeM := edgeP edgeF mat [] []

/-- error: mojo_kernel: mat needs reads a1, a2, writes a0 and scalars a3, a4, a5 (naive.fn_0) -/
#guard_msgs in
mojo_kernel naiveM := naive.prog naive.fn_0 reads bA := a2, bB := a1 writes bC := a0
  scalars m := a3, n := a4, K := a5 contract mat [skipN] [chainN]

/-- error: mojo_kernel: mat: the clause name x is a binder name of naiveX.sound_mat (naive.fn_0) -/
#guard_msgs in
mojo_kernel naiveX := naive.prog naive.fn_0 reads x := a1, bB := a2 writes bC := a0
  scalars m := a3, n := a4, K := a5 contract mat [skipN] [chainN]

/-- error: mojo_kernel: mat needs a path; with no paths the theorem covers only launches with no thread out of bounds (naive.fn_0) -/
#guard_msgs in
mojo_kernel naiveP := naive.prog naive.fn_0 reads bA := a1, bB := a2 writes bC := a0
  scalars m := a3, n := a4, K := a5 contract mat [] [chainN]

/-- error: mojo_kernel: mat needs a chain; with no chains the theorem covers only launches with no thread in bounds (naive.fn_0) -/
#guard_msgs in
mojo_kernel naiveC := naive.prog naive.fn_0 reads bA := a1, bB := a2 writes bC := a0
  scalars m := a3, n := a4, K := a5 contract mat [skipN] []

end Clause

end MojoProofTest.NaiveSound
