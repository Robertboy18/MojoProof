import MojoProofTest.NaiveSpec
import MojoProof.Sym.KernelCmd

/-!
# The naive matmul kernel's theorem, composed from its threads' runs

For the one program `naive` (MojoProofTest/SymPhi.lean), compiled with `fmul contract`, this
module composes the kernel theorem from its threads' runs, at every launch valid with `z`
sides 1 and every memory of its family:

* `naive_sound`: `Kernel.Sound` of `naive` with `Elem.Out` of the naive bytes
  (`NaiveSpec.bytes`), the instance of the library's `Kernel.sound_mat` (Sym/KernelMat.lean)
  at `contract := true`, from memory premises in the field shape of `Mat.Pre` and the threads'
  run theorems `NaiveSpec.RunIn` (a thread in bounds runs the loop to `ret`) and
  `NaiveSpec.RunOut` (a thread out of bounds skips to `ret`), which are premises here and proved
  apart. The `mat` clause of `mojo_kernel` (MojoProof/Sym/KernelCmd.lean) at the skip path
  `skipN` and the loop's chain `chainN` adds the start on the arguments `Mat.args`
  (Sem/Precond.lean), the register names it uses and the kernel theorem at those, with the runs
  as its two premises; the proof applies it and builds `NaiveSpec.At` from the facts it gives
  each thread. With the runs proved (`NaiveIn.runIn`, `NaiveOut.runOut`) it is
  `NaiveKernel.correct`.
* the tests of the `mat` clause: its open goals at `naive`, the two runs, and five refusals.
* `naive_read`: every observation's block `C`, read off: each cell in bounds holds the
  binary32 word of its one thread, the other bytes and blocks are the caller's.
  `naive_matmul`: for every `K ≤ 768`, each cell against TorchLean's `Tensor.matmul` of the
  first `K` columns of `A` and of `B`ᵀ (`cols`), up to NaNs with no round fused, and within
  `dotBound` when finite.
-/

namespace MojoProofTest.NaiveSound

open MojoProof MojoProof.LLVM MojoProof.Sem MojoProof.Sym MojoProofTest.SymPhi
  MojoProofTest.NaiveThread MojoProofTest.NaiveSpec
open FloatLib.Floats.Formats.BinaryInterchange TorchLean

-- `naive.names`, `naive.starts` and `naive.sound_mat`: the kernel theorem of `naive` from its
-- threads' runs, generated by the `mat` clause with the skip path and the loop's chain
mojo_kernel naive := naive.prog naive.fn_0 reads bA := a1, bB := a2 writes bC := a0
  scalars m := a3, n := a4, K := a5 contract mat [skipN] [chainN]

/-- **The naive matmul kernel's theorem, composed from its threads' runs.** For the one program
`naive` with `fmul contract`, every oracles `ω`, launch `L` valid with `z` sides 1, sizes `m`, `n`,
`K`, buffer blocks `bC`, `bA`, `bB`, tensors `A` (`m × 768`), `B` (`n × 768`) and caller's memory
`mem`, `naive` on `Mat.args z bC bA bB m n K` is sound for the caller's admissible oracles `ω` and
the observation of the blocks, with `Elem.Out`: block `bC` is `mem`'s with the binary32 word of each
thread in bounds put at its cell, `dotLoop` with `fmul contract` from `+0` over the first `K`
pairs of its row of `A` and its row of `B` (`NaiveSpec.bytes`), and every other block is
`mem`'s. Premises:

* the memory premises, in the field shape of `Map2.Pre` (Sem/Precond.lean): `mem` is closed for
  the arguments, `bA` and `bB` differ from `bC`, the three blocks are buffers of the sizes of
  `A`, `B` and `C` (`C` with row stride 50257, writable), `A` and `B` are held row-major,
  `n ≤ 50257`, `K ≤ 768`, the index products fit `i32`, and the buffers fit their spaces;
* `hin`, `hout`: the threads' run theorems (`NaiveSpec.RunIn` for a thread in bounds, the loop,
  and `NaiveSpec.RunOut` for a thread out of bounds, the skip path), proved apart.

The proof is `naive.sound_mat`, the `mat` clause's `Kernel.sound_mat (contract := true)` at the
one path `skipN` and the one chain `chainN`, with `NaiveSpec.At` built from the facts it gives
each thread and the memory premises. It is for this one program and covers every launch and
memory of its family. -/
theorem naive_sound {ω : Nat → Nat → Nat} {L : Launch} (hL : L.Valid)
    (hz : L.grid .z = 1 ∧ L.block .z = 1) {m n K bC bA bB : Nat}
    {A : Tensor (Model FloatTy.float.fmt) [m, 768]} {B : Tensor (Model FloatTy.float.fmt) [n, 768]}
    {mem : Mem} (hC : mem.Closed (Mat.args z bC bA bB m n K)) (hne : bA ≠ bC ∧ bB ≠ bC)
    (hbuf : mem.Buffer bA (m * 768 * 4) 4 false ∧ mem.Buffer bB (n * 768 * 4) 4 false ∧
      mem.Buffer bC (m * 50257 * 4) 4 true)
    (hA : mem.Holds naive.prog.layout bA (.fp .float) (Val.ofFloat .float)
      (rowMajor naive.prog.layout (.fp .float) 0) A)
    (hB : mem.Holds naive.prog.layout bB (.fp .float) (Val.ofFloat .float)
      (rowMajor naive.prog.layout (.fp .float) 0) B)
    (hd : n ≤ 50257 ∧ K ≤ 768 ∧ m * 50257 < 2 ^ 31 ∧ m * 768 < 2 ^ 31 ∧ n * 768 < 2 ^ 31)
    (hfit : mem.Fits naive.prog.layout bA (m * 768 * 4) ∧
      mem.Fits naive.prog.layout bB (n * 768 * 4) ∧
      mem.Fits naive.prog.layout bC (m * 50257 * 4))
    (hin : RunIn ω L K bC bA bB A B) (hout : RunOut ω L K bC bA bB A B) :
    Kernel.Sound naive.prog naive.fn_0 L (Mat.args z bC bA bB m n K) mem (fun _ ω' => ω' = ω)
      (fun m => some m.blocks)
      (Elem.Out mem bC (cell L) (bytes ω L K A B) (volume L.grid * volume L.block)) := by
  have i0 : idx "0" = 0 := by decide +kernel
  have i1 : idx "1" = 1 := by decide +kernel
  have i2 : idx "2" = 2 := by decide +kernel
  have i3 : idx "3" = 3 := by decide +kernel
  have i4 : idx "4" = 4 := by decide +kernel
  have i5 : idx "5" = 5 := by decide +kernel
  exact naive.sound_mat (t := .fp .float) (enc := Val.ofFloat .float) (al := 4) (sA := 768)
    (sB := 768) (sC := 50257) (w := 4) hL hz hC hne hbuf hA hB hd.1 hfit
    (fun _ _ e k hS c hcp hce hcw hco m₀ m' f hf q0 q1 q2 hr0 hr1 hr2 hp hv0 hv1 hv2 hr3 hr4 hr5
        hA' hB' hC' hFa hFb hFc hx hy hE hO =>
      hin k q0 q1 q2 c m₀ m' f hS (e ▸ hco) ⟨hL, hz, hd, hS.1, ⟨hcp, hce, hcw⟩, hf,
        ⟨i0 ▸ hr0, i1 ▸ hr1, i2 ▸ hr2, hp⟩, ⟨hv0, hv1, hv2⟩, ⟨i3 ▸ hr3, i4 ▸ hr4, i5 ▸ hr5⟩, hne,
        ⟨hA', hFa, hx⟩, ⟨hB', hFb, hy⟩, ⟨hC', hFc⟩⟩ hE hO)
    (fun _ _ _ k hk hS c hcp hce hcw _ m₀ m' f hf q0 q1 q2 hr0 hr1 hr2 hp hv0 hv1 hv2 hr3 hr4
        hr5 hA' hB' hC' hFa hFb hFc hx hy hE hO =>
      hout k q0 q1 q2 c m₀ m' f hS ⟨hL, hz, hd, hk, ⟨hcp, hce, hcw⟩, hf,
        ⟨i0 ▸ hr0, i1 ▸ hr1, i2 ▸ hr2, hp⟩, ⟨hv0, hv1, hv2⟩, ⟨i3 ▸ hr3, i4 ▸ hr4, i5 ▸ hr5⟩, hne,
        ⟨hA', hFa, hx⟩, ⟨hB', hFb, hy⟩, ⟨hC', hFc⟩⟩ hE hO)

/-- **The cells of `C` after the naive kernel, read off.** For every program, function, arguments,
oracles `ω`, launch `L` valid with `z` sides 1, sizes `m`, `n ≤ 50257` (the row stride of `C`),
count `K`, block `bC`, tensors `A`, `B` and caller's memory whose block `bC` is `x`: if the kernel
is sound for `Elem.Out` of the naive kernel's bytes (`naive_sound` for `naive`), every
observation `Bk` of a run under `ω` (`Kernel.Obs`) has a block `y` at `bC` with

* for every cell `(r, c)` with `r < m`, `c < n` and in the launch's window, the one thread `k`
  of row `r` and column `c` (`Launch.cell_onto`; unique by `Launch.xy_inj`), whose `4` bytes at
  offset `(r * 50257 + c) * 4` encode `dotLoop` with `fmul contract`, under thread `k`'s
  oracle numbers `o (ω k)`, from `+0` over `pairs A B r c K` (`Elem.put_read`);
* `x`'s bytes at every offset outside the cells of the threads in bounds (`Elem.put_out`);
* every other block of the caller's memory unchanged.

It covers every launch and memory of the family; for `naive` its premise is `naive_sound`'s. -/
theorem naive_read {prog : Program} {fn : Func} {args : List Val} {ω : Nat → Nat → Nat}
    {L : Launch} (hL : L.Valid) (hz : L.grid .z = 1 ∧ L.block .z = 1) {m n K : Nat}
    (hn : n ≤ 50257) {bC : Nat} {A : Tensor (Model FloatTy.float.fmt) [m, 768]}
    {B : Tensor (Model FloatTy.float.fmt) [n, 768]} {mem : Mem}
    (h : Kernel.Sound prog fn L args mem (fun _ ω' => ω' = ω) (fun m => some m.blocks)
      (Elem.Out mem bC (cell L) (bytes ω L K A B) (volume L.grid * volume L.block)))
    {x : Sem.Block} (hx : mem.blocks bC = some x) {ch : Nat → Nat}
    {Bk : Nat → Option Sem.Block}
    (hB : Kernel.Obs prog fn L args mem (fun m => some m.blocks) ch ω Bk) :
    ∃ y, Bk bC = some y ∧
      (∀ r c (hr : r < m) (hc : c < n), r < L.grid .x * L.block .x →
        c < L.grid .y * L.block .y →
        ∃ k < volume L.grid * volume L.block, L.index k .x = r ∧ L.index k .y = c ∧
          (∀ k' < volume L.grid * volume L.block, L.index k' .x = r → L.index k' .y = c →
            k' = k) ∧
          naive.prog.layout.encode (.fp .float) (.ofFloat .float
            (dotLoop true (o (ω k)) (Model.zero _ false) (pairs A B ⟨r, hr⟩ ⟨c, hc⟩ K))) =
            some (y.read ((r * 50257 + c) * 4) 4)) ∧
      (∀ i, (∀ k, S L m n k → i < cell L k ∨ cell L k + 4 ≤ i) → y.bytes i = x.bytes i) ∧
      ∀ b x', b ≠ bC → mem.blocks b = some x' → Bk b = some x' := by
  have hO := Kernel.Sound.obs h rfl hB
  have hS : ∀ k l, bytes ω L K A B k = some l → S L m n k ∧ l.length = 4 := fun k l hb => by
    unfold bytes at hb
    split at hb
    · exact ⟨by assumption, (Elem.encode_float hb).1⟩
    · cases hb
  refine ⟨_, hO.1 x hx, fun r c hr hc hX hY => ?_,
    fun i hi => Elem.put_out x fun k _ l hl => ?_, hO.2⟩
  · obtain ⟨k, hk, rfl, rfl⟩ := Launch.cell_onto hL hX hY
    refine ⟨k, hk, rfl, rfl, fun k' hk' ex ey => Launch.xy_inj hL hz hk' hk (by rw [ex])
      (by rw [ey]), ?_⟩
    have hap : Apart (fun i : {i // bytes ω L K A B i ≠ none} => cell L i) 4 := fun i j hij => by
      have hs : ∀ i : {i // bytes ω L K A B i ≠ none}, S L m n i.1 := fun i => by
        obtain ⟨l, hl⟩ := Option.ne_none_iff_exists'.1 i.2
        exact (hS _ _ hl).1
      exact Launch.apart_xy (s := 50257) (m := m) hL hz hn 4 ⟨i.1, hs i⟩ ⟨j.1, hs j⟩
        fun e => hij (Subtype.ext (congrArg (fun x : {k // S L m n k} => x.1) e))
    obtain ⟨e, he, -, -⟩ := (Layout.Codec.float naive.prog.layout .float).round
      (dotLoop true (o (ω k)) (Model.zero _ false) (pairs A B ⟨_, hr⟩ ⟨_, hc⟩ K))
    have hb : bytes ω L K A B k = some e := by
      unfold bytes
      rw [dite_eq_left ⟨hk, hr, hc⟩]
      exact he
    have := Elem.put_read hap (fun k l h => (hS k l h).2) x (k := k) (by simp [hb])
      (volume L.grid * volume L.block)
    rw [ite_eq_left hk, hb, Option.getD_some] at this
    rw [he]
    exact congrArg some this.symm
  · obtain ⟨h1, h2⟩ := hS k l hl
    rw [h2]
    exact hi k h1

/-- **The cells of `C` after the naive kernel against TorchLean's product**, for every `K ≤ 768`.
Under the premises of `naive_read` (every program, launch valid with `z` sides 1, sizes with
`n ≤ 50257`, tensors and memory, given the kernel's soundness for the naive bytes), every
observation has a block `y` at `bC` where every cell `(r, c)` in bounds and in the launch's window
is computed by one thread `k` and holds the binary32 encoding of a word `v` with

* `v` and entry `(r, c)` of TorchLean's `Tensor.matmul` of the first `K` columns of `A` and the
  transpose of the first `K` columns of `B` (`cols`) `NaNEq` (the same word or both NaNs) when no
  `fadd` oracle number of thread `k` is `2` modulo `3` (no round fused; `matmul_take_nanEq`);
* when `v` is finite, `|v - (A Bᵀ)ᵣ꜀|` over the reals on those columns at most `dotBound` of
  binary32 at `K` and `Σⱼ<K |aᵣⱼ b꜀ⱼ|`, for every choice of fused rounds (`matmul_take_error`).

It covers every launch and memory of the family and every `K ≤ 768`; at `K = 768` the columns are
all of `A` and of `B`. -/
theorem naive_matmul {prog : Program} {fn : Func} {args : List Val} {ω : Nat → Nat → Nat}
    {L : Launch} (hL : L.Valid) (hz : L.grid .z = 1 ∧ L.block .z = 1) {m n K : Nat}
    (hn : n ≤ 50257) (hK : K ≤ 768) {bC : Nat} {A : Tensor (Model FloatTy.float.fmt) [m, 768]}
    {B : Tensor (Model FloatTy.float.fmt) [n, 768]} {mem : Mem}
    (h : Kernel.Sound prog fn L args mem (fun _ ω' => ω' = ω) (fun m => some m.blocks)
      (Elem.Out mem bC (cell L) (bytes ω L K A B) (volume L.grid * volume L.block)))
    {x : Sem.Block} (hx : mem.blocks bC = some x) {ch : Nat → Nat}
    {Bk : Nat → Option Sem.Block}
    (hB : Kernel.Obs prog fn L args mem (fun m => some m.blocks) ch ω Bk) :
    ∃ y, Bk bC = some y ∧
      ∀ r c (hr : r < m) (hc : c < n), r < L.grid .x * L.block .x →
        c < L.grid .y * L.block .y →
        ∃ k < volume L.grid * volume L.block, L.index k .x = r ∧ L.index k .y = c ∧
          ∃ v, naive.prog.layout.encode (.fp .float) (.ofFloat .float v) =
            some (y.read ((r * 50257 + c) * 4) 4) ∧
          ((∀ j, (o (ω k) j).2 % 3 ≠ 2) → NaNEq v (Tensor.get2 (Tensor.matmul (cols K hK A)
            (Tensor.permute (cols K hK B) (Shape.adjacentSwap [n, K] 0) [K, n])) ⟨r, hr⟩
              ⟨c, hc⟩)) ∧
          (v.isFinite = true → |v.toReal - Tensor.get2 (Tensor.matmul
            (Tensor.map Model.toReal (cols K hK A)) (Tensor.map Model.toReal
              (Tensor.permute (cols K hK B) (Shape.adjacentSwap [n, K] 0) [K, n])))
                ⟨r, hr⟩ ⟨c, hc⟩| ≤ dotBound FloatTy.float.fmt K ((pairs A B ⟨r, hr⟩ ⟨c, hc⟩
                  K).map fun ab => |ab.1.toReal * ab.2.toReal|).sum) := by
  obtain ⟨y, hy, hc, -, -⟩ := naive_read hL hz hn h hx hB
  refine ⟨y, hy, fun r c hr hc' hX hY => ?_⟩
  obtain ⟨k, hk, ex, ey, -, he⟩ := hc r c hr hc' hX hY
  exact ⟨k, hk, ex, ey, _, he, fun hu => matmul_take_nanEq true _ A B hK _ _ fun j _ => hu j,
    matmul_take_error (isIEEE_fmt _) true _ A B hK _ _⟩


