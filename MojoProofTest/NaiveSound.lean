ω : ℕ → ℕ → ℕ
⊢ ∀ (ch : ℕ → ℕ) (oracle : ℕ → ℕ → ℕ),
    oracle = ω →
      ∀ (k q0 q1 q2 : ℕ) (c : Ctx) (m₀ m' : Mem) (f : Frame),
        k < volume L.grid * volume L.block ∧ L.index k Dim.x < m ∧ L.index k Dim.y < n →
          c.oracle = oracle k →
            Mat.Entry naive.prog naive.fn_0 L
                (Ty.struct
                  [Ty.ptr 0,
                    Ty.struct [Ty.struct [Ty.struct [], Ty.struct []], Ty.struct [Ty.struct [], Ty.struct []]]])
                (Val.agg [Val.agg [Val.agg [], Val.agg []], Val.agg [Val.agg [], Val.agg []]]) 8 (Ty.fp FloatTy.float)
                (Val.ofFloat FloatTy.float) 4 bC bA bB K 50257 A B k c q0 q1 q2 m' f →
              Elem m₀ bC 4 (fun k => (L.index k Dim.x * 50257 + L.index k Dim.y) * 4) (bytes ω L K A B) k m' →
                Elem.Only bC (fun k => k < volume L.grid * volume L.block ∧ L.index k Dim.x < m ∧ L.index k Dim.y < n)
                    m' →
                  ∃ C ∈ [chainN],
                    RetLsWith true
                      (fun me =>
                        Elem m₀ bC 4 (fun k => (L.index k Dim.x * 50257 + L.index k Dim.y) * 4) (bytes ω L K A B)
                            (k + 1) me ∧
                          Elem.Only bC
                            (fun k => k < volume L.grid * volume L.block ∧ L.index k Dim.x < m ∧ L.index k Dim.y < n)
                            me)
