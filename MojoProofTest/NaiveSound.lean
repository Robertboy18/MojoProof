#guard_msgs in
mojo_kernel naiveM := naive.prog naive.fn_0 reads bA := a2, bB := a1 writes bC := a0
  scalars m := a3, n := a4, K := a5 contract mat [skipN] [chainN]

/-- error: mojo_kernel: mat: the clause name x is a binder name of naiveX.sound_mat or naiveX.out (naive.fn_0) -/
#guard_msgs in
