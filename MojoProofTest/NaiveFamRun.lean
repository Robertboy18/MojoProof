import MojoProofTest.SymNaive
import MojoProofTest.SymSelect
import MojoProof.Sym.Obl
import MojoProofTest.NaiveFam
import MojoProofTest.NaiveSound
import MojoProof.Sym.OblHave
import MojoProof.Sym.Inv
import MojoProofTest.Family
import MojoProofTest.KernelRfl
import MojoProof.Sym.Family

/-!
# The naive matmul kernel at every row stride: its run and its theorem

`NaiveFam.prog sA sB sC` and `NaiveFam.fn sA sB sC` (MojoProofTest/Family.lean) are the naive
matmul kernel with the constants of its three stride multiplications as parameters, the row
strides `sA` of `A`, `sB` of `B` and `sC` of `C`; MojoProofTest/NaiveFam.lean states the
family's cells, `cell sC`, `pairs` and `bytes`, and reads them off every sound kernel. This
module proves the kernel sound at every stride (docs/proofs/naive.md):

* `entryF`: the summary of the entry block `%6` as a function of the strides (the command
  `sym_summary_family`, MojoProof/Sym/Family.lean), with its equation `entryF_eq` and its
  value at the corpus strides, `entryF_corpus`; `chainF` and `skipF`, the paths of a thread in and
  out of bounds, checked at every stride (`chainF_ok`, `skipF_ok`, through `coversAt_eq`).
* The obligations at every stride, by mojo_obl: the edge into the loop and the skip paths (in
  `runF` and `outF`), a round (`roundsF`) and the path out of the loop (`exitF`).
* The run of a thread in bounds, `runInF`, `RetLsWith.of_iter` at the invariant
  `NaiveThread.Inv` with its head, round and exit, `head_inF`, `round_inF` and `exit_inF`; a
  thread out of bounds, `outF`; the start of the grid, `startsF`.
* `sound`: `Kernel.Sound` of the family's program for `Elem.Out` of `bytes` at the cells
  `cell sC`, for every row stride and `K` that `Mat.Pre` admits, with `m`, `n`, `K` below
  `2 ^ 31`; `sound_512_512_256`, its instance at the strides of tests/corpus/naive_k512/.

`NaiveKernel.correct` is `sound` at the corpus strides `768`, `768`, `50257` (by
`NaiveFam.prog_corpus`, which `mojo_family` adds), and `NaiveIn`'s head, round, exit and run are
those of this module there (`entryF_corpus`, `headF_corpus`).
-/

open MojoProof MojoProof.LLVM MojoProof.Sem MojoProof.Sym

namespace MojoProofTest.NaiveFam
open MojoProofTest.SymPhi MojoProofTest.SymNaive MojoProofTest.SymSelect
open FloatLib.Floats.Formats.BinaryInterchange

/-- The summary of the entry block `%6` of `fn sA sB sC` from position 0, with `fmul contract`,
at every stride (generated by `sym_summary_family`). -/
sym_summary_family entryF (sA sB sC) := prog fn naive.fn_0.b_0.label 0 contract

/-- The entry summary at the corpus strides `768`, `768`, `50257` is the corpus program's,
`SymSelect.entry` (the kernel decides it). -/
theorem entryF_corpus : entryF 768 768 50257 = SymSelect.entry := by decide +kernel

/--
error: sym_summary_family: block 1000000 of fn from position 0 is outside the checker's fragment
-/
#guard_msgs (whitespace := lax) in
sym_summary_family missingF (sA sB sC) := prog fn 1000000 0

/-- The chain of a thread in bounds at strides `sA`, `sB`, `sC`: the entry block `%6` (`entryF`),
the edge into the loop (`SymNaive.pre`) and the loop `SymNaive.naiveL`, for every stride. At the
corpus strides it is `NaiveThread.chainN`. -/
abbrev chainF (sA sB sC : Nat) : LoopChain :=
  ⟨naive.fn_0.b_0.label, (entryF sA sB sC).obls, entryF sA sB sC,
    [(naive.fn_0.b_2.label, pre.obls, pre)], [naiveL]⟩

/-- The path of a thread out of bounds at strides `sA`, `sB`, `sC`: `%6` (`entryF`), `%44` and the
`ret` block, for every stride. -/
abbrev skipF (sA sB sC : Nat) : List (Nat × List Cond × Summary) :=
  [(naive.fn_0.b_0.label, (entryF sA sB sC).obls, entryF sA sB sC),
    (naive.fn_0.b_1.label, skip.obls, skip),
    (naive.fn_0.b_8.label, Kernels.vadd.b3.obls, Kernels.vadd.b3)]

/-- The loop head after the entry block at strides `sA`, `sB`, `sC`, from valuation `V`: the
round of `%6` (`entryF`) and the edge `%45 → %46`, for every stride and valuation. At the corpus
strides it is `NaiveThread.head` (`headF_corpus`). -/
abbrev headF (sA sB sC : Nat) (V : Valuation) : Valuation :=
  Valuation.roundWith true naive.fn_0.b_0.label (entryF sA sB sC)
    [(naive.fn_0.b_2.label, pre.obls, pre)] V

/-- At the corpus strides `768`, `768`, `50257`, `headF` is `NaiveThread.head`, for every
valuation (`entryF_corpus`). -/
theorem headF_corpus (V : Valuation) : headF 768 768 50257 V = NaiveThread.head V :=
  congrArg (fun S => Valuation.roundWith true naive.fn_0.b_0.label S
    [(naive.fn_0.b_2.label, pre.obls, pre)] V) entryF_corpus

/-- **The block checker accepts `chainF` at every stride** `sA`, `sB`, `sC`: the entry's check
is the prefix test of `entryF`'s obligations (`coversAt_eq`, `entryF_eq`), and the kernel
evaluates the rest. -/
theorem chainF_ok (sA sB sC : Nat) :
    coversChainsWith true (prog sA sB sC) (fn sA sB sC) [chainF sA sB sC] = true := by
  simp only [coversChainsWith, coversChainsAt, List.all_cons, List.all_nil, Bool.and_true,
    coversChainAt, coversPathAt, coversAt_eq (entryF_eq sA sB sC)]
  kernel_rfl

/-- **The block checker accepts `skipF` at every stride** `sA`, `sB`, `sC` (`coversAt_eq`,
`entryF_eq`, the rest by the kernel). -/
theorem skipF_ok (sA sB sC : Nat) :
    coversEntryWith true (prog sA sB sC) (fn sA sB sC) [skipF sA sB sC] = true := by
  simp only [coversEntryWith, coversEntryAt, List.all_cons, List.all_nil, Bool.and_true,
    coversPathAt, coversAt_eq (entryF_eq sA sB sC)]
  kernel_rfl

/-- The registers the loop keeps at every stride: `%16`, `%26`, `%11`, `%37`, `%12`, `%40`
(the kernel evaluates `LoopSeg.kept` under the binders). -/
theorem kept_eq (sA sB sC : Nat) : naiveL.kept (fn sA sB sC) = [16, 26, 11, 37, 12, 40] := by
  kernel_rfl

/-- The loop's loads at every stride read through `%11` and `%12` only (the kernel evaluates
`LoopSeg.loadsFrom` under the binders). -/
theorem loads_eq (sA sB sC : Nat) : naiveL.loadsFrom (fn sA sB sC) [11, 12] = true := by
  kernel_rfl

/-- The side conditions of `RetWith.of_first` on `skipF` at every stride: the entry's memory
obligation is among its obligations, the later blocks have no effects and the last returns. -/
theorem skip_hp (sA sB sC : Nat) :
    Cond.mem (entryF sA sB sC).effs ∈ (entryF sA sB sC).obls ∧
      (∀ b ∈ (skipF sA sB sC).tail, b.2.2.effs = []) ∧
      (skipF sA sB sC).getLast?.map (·.2.2.exit) = some .ret :=
  of_decide_eq_true (by kernel_rfl)

/-- **The kept registers at the head of every round**, for every stride, launch `L` valid, sizes
below `2 ^ 31`, thread `k` in bounds with the facts of `Mat.Entry` at the family's program and
function and round count `i`: `%16` is `smax(K, 0)`, `%26` and `%37` are the thread's row times
`sA` and column times `sB`, `%11` and `%12` point at `a` and `b`, and `%40` is its value at the
loop head (`LoopSeg.kept_round`, the values at the head by `obl_have`). -/
theorem keptF {sA sB sC : Nat} {L : Launch} (hL : L.Valid) {bC bA bB m n K : Nat}
    {α : Type} [TorchLean.Storage α] {t : Ty} {enc : α → Val} {al sA' sB' : Nat}
    {x : TorchLean.Tensor α [m, sA']} {y : TorchLean.Tensor α [n, sB']}
    (hsz : m < 2 ^ 31 ∧ n < 2 ^ 31 ∧ K < 2 ^ 31)
    {k q0 q1 q2 : Nat} {c : Ctx} {m' : Mem} {f : Frame}
    (hS : k < volume L.grid * volume L.block ∧ L.index k .x < m ∧ L.index k .y < n)
    (h : Mat.Entry (prog sA sB sC) (fn sA sB sC) L NaiveSpec.T NaiveSpec.z 8 t enc al bC bA bB K
      sC x y k c q0 q1 q2 m' f) (i : Nat) {W : Valuation}
    (hW : W = (Valuation.roundWith true naiveL.h naiveL.H naiveL.B)^[i]
      (headF sA sB sC (Valuation.entry c 0 m' f))) :
    W.regs 16 = some (.bits 64 (BitVec.ofNat 64 (max K 0))) ∧
      W.regs 26 = some (.bits 32 (BitVec.ofNat 32 (L.index k .x * sA))) ∧
      W.regs 11 = some (.ptr ⟨bA, 0⟩) ∧
      W.regs 37 = some (.bits 32 (BitVec.ofNat 32 (L.index k .y * sB))) ∧
      W.regs 12 = some (.ptr ⟨bB, 0⟩) ∧
      W.regs 40 = (headF sA sB sC (Valuation.entry c 0 m' f)).regs 40 := by
  have h' := h
  obtain ⟨⟨hcp, hce, hcw⟩, hfn, ⟨hr0, hr1, hr2, hp0, hp1, hp2⟩, ⟨hv0, hv1, hv2⟩,
    ⟨hr3, hr4, hr5⟩, hbA, hbB, hbC⟩ := h'
  obtain ⟨hm, hn, hK⟩ := hsz
  obtain ⟨hk, hX, hY⟩ := hS
  replace hX : (L.env k).sreg .ctaid .x * (L.env k).sreg .ntid .x + (L.env k).sreg .tid .x < m := hX
  replace hY : (L.env k).sreg .ctaid .y * (L.env k).sreg .ntid .y + (L.env k).sreg .tid .y < n := hY
  have hf : (headF sA sB sC (Valuation.entry c 0 m' f)).fn = fn sA sB sC := by mojo_inv
  obl_have g0 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs 16,
    g1 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs 26,
    g2 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs 11,
    g3 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs 37,
    g4 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs 12,
    g5 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs 40
  simp only [← Launch.index.eq_1] at g0 g1 g2 g3 g4 g5
  have hmem (r : Nat) (hr : r ∈ [16, 26, 11, 37, 12, 40]) : r ∈ naiveL.kept (fn sA sB sC) :=
    kept_eq sA sB sC ▸ hr
  subst hW
  exact ⟨LoopSeg.kept_round (c := true) (hmem 16 (by simp)) hf g0 i,
    LoopSeg.kept_round (c := true) (hmem 26 (by simp)) hf g1 i,
    LoopSeg.kept_round (c := true) (hmem 11 (by simp)) hf g2 i,
    LoopSeg.kept_round (c := true) (hmem 37 (by simp)) hf g3 i,
    LoopSeg.kept_round (c := true) (hmem 12 (by simp)) hf g4 i,
    (LoopSeg.kept_round (c := true) (hmem 40 (by simp)) hf g5 i).trans g5.symm⟩

/-- **A round's obligations at every stride** (`RoundWith`), for every `K ≤ sA`, `K ≤ sB`, row
`r < m`, column `c < n` with `m * sA`, `n * sB` below `2 ^ 31`, count `i < smax(K, 0)`,
accumulator word and valuation `W` of the family's function whose registers and buffers are those
of the loop head (mojo_obl). -/
theorem roundsF (sA sB K m n r c bA bB i : Nat) (acc : BitVec 32)
    (A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA])
    (B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]) (W : Valuation) {sC : Nat}
    (hKA : K ≤ sA) (hKB : K ≤ sB) (hm : m * sA < 2 ^ 31) (hn : n * sB < 2 ^ 31)
    (hr' : r < m) (hc' : c < n) (hr : r * sA + sA ≤ m * sA) (hc : c * sB + sB ≤ n * sB)
    (hi : i < max K 0) (hP : W.ctx.prog = prog sA sB sC) (hfn : W.fn = fn sA sB sC)
    (h47 : W.regs (idx "47") = some (.bits 64 (BitVec.ofNat 64 i)))
    (h16 : W.regs (idx "16") = some (.bits 64 (BitVec.ofNat 64 (max K 0))))
    (h48 : W.regs (idx "48") = some (.bits 32 acc))
    (h26 : W.regs (idx "26") = some (.bits 32 (BitVec.ofNat 32 (r * sA))))
    (h37 : W.regs (idx "37") = some (.bits 32 (BitVec.ofNat 32 (c * sB))))
    (h11 : W.regs (idx "11") = some (.ptr ⟨bA, 0⟩))
    (h12 : W.regs (idx "12") = some (.ptr ⟨bB, 0⟩))
    (hbA : W.mem.Buffer bA (m * sA * 4) 4 false) (hbB : W.mem.Buffer bB (n * sB * 4) 4 false)
    (hfA : W.mem.Fits naive.prog.layout bA (m * sA * 4))
    (hfB : W.mem.Fits naive.prog.layout bB (n * sB * 4))
    (hA : W.mem.Holds naive.prog.layout bA (.fp .float) (Val.ofFloat .float)
      (rowMajor naive.prog.layout (.fp .float) 0) A)
    (hB : W.mem.Holds naive.prog.layout bB (.fp .float) (Val.ofFloat .float)
      (rowMajor naive.prog.layout (.fp .float) 0) B) :
    RoundWith true naiveL.h naiveL.p naiveL.dh naiveL.H naiveL.B W := by
  mojo_obl

/-- **The path out of the loop's obligations at every stride** (`WalkWith` of `%46 → %51 → %67 →
%69`), for every `K < 2 ^ 31`, column `c < sC`, row `r` with `r * sC + sC ≤ m * sC`, accumulator
word and valuation `W` of the family's function at the head of round `smax(K, 0)` with `C`'s
buffer and fit (mojo_obl). -/
theorem exitF (sC K m r c bC : Nat) (acc : BitVec 32) (W : Valuation) {sA sB : Nat}
    (hK : K < 2 ^ 31) (hc : c < sC) (hr : r * sC + sC ≤ m * sC)
    (hP : W.ctx.prog = prog sA sB sC) (hfn : W.fn = fn sA sB sC)
    (h47 : W.regs (idx "47") = some (.bits 64 (BitVec.ofNat 64 (max K 0))))
    (h16 : W.regs (idx "16") = some (.bits 64 (BitVec.ofNat 64 (max K 0))))
    (h48 : W.regs (idx "48") = some (.bits 32 acc))
    (h40 : W.regs (idx "40") =
      some (.ptr ⟨bC, ((r * sC + c) * naive.prog.layout.size (.fp .float) : Nat)⟩))
    (hbC : W.mem.Buffer bC (m * sC * 4) 4 true)
    (hfC : W.mem.Fits naive.prog.layout bC (m * sC * 4)) :
    WalkWith true W ((naiveL.h, naiveL.dh, naiveL.H) :: naiveL.X) := by
  mojo_obl

/-- **The run of a thread in bounds from the loop's three premises**, for every stride, launch
`L` valid, sizes below `2 ^ 31`, thread `k` in bounds at which `Mat.Entry` holds with `bA`, `bB`
not `bC`, `Elem` and `Elem.Only` on its memory, postcondition `Q` and invariant `I`: if the head,
rounds and exit of `LoopIterWith` hold at the trip count `smax(K, 0)`, the thread runs `chainF`
to `ret` with a memory of `Q` (`RetLsWith.of_iter`; the edge into the loop by mojo_obl, `Mat.Head`
at every round by `Mat.Head.iterate`). -/
theorem runF {sA sB sC : Nat} {L : Launch} (hL : L.Valid) {bC bA bB m n K : Nat}
    {A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA]}
    {B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]}
    (hsz : m < 2 ^ 31 ∧ n < 2 ^ 31 ∧ K < 2 ^ 31)
    {bs : Nat → Option (List MemByte)} {k q0 q1 q2 : Nat} {c : Ctx} {m₀ m' : Mem} {f : Frame}
    (hS : k < volume L.grid * volume L.block ∧ L.index k .x < m ∧ L.index k .y < n)
    (h : Mat.Entry (prog sA sB sC) (fn sA sB sC) L NaiveSpec.T NaiveSpec.z 8 (.fp .float)
      (Val.ofFloat .float) 4 bC bA bB K sC A B k c q0 q1 q2 m' f) (hne : bA ≠ bC ∧ bB ≠ bC)
    (hE : Elem m₀ bC 4 (cell sC L) bs k m') (hO : Elem.Only bC (NaiveSpec.S L m n) m')
    {Q : Mem → Prop} {I : Nat → Valuation → Prop}
    (H : LoopIterWith true naiveL (Valuation.entry c 0 m' f) naive.fn_0.b_0.label (entryF sA sB sC)
      [(naive.fn_0.b_2.label, pre.obls, pre)] Q (max K 0)
      (Mat.Head (prog sA sB sC) (fn sA sB sC) (.fp .float) (Val.ofFloat .float) 4 bC bA bB sC A B 4
        (cell sC L) bs k m₀ (NaiveSpec.S L m n)) I) :
    RetLsWith true Q [naiveL] (Valuation.entry c 0 m' f) naive.fn_0.b_0.label
      (entryF sA sB sC).obls (entryF sA sB sC) [(naive.fn_0.b_2.label, pre.obls, pre)] := by
  refine RetLsWith.of_iter (L := naiveL) rfl ?_ ?_ H
  · clear H hE hO
    obtain ⟨⟨hcp, hce, -⟩, hfn, ⟨hr0, hr1, hr2, hp0, hp1, hp2⟩, ⟨hv0, hv1, hv2⟩,
      ⟨hr3, hr4, hr5⟩, -, -, ⟨hbC, hfC⟩⟩ := h
    obtain ⟨hm, hn, hK⟩ := hsz
    obtain ⟨hk, hX, hY⟩ := hS
    replace hX :
        (L.env k).sreg .ctaid .x * (L.env k).sreg .ntid .x + (L.env k).sreg .tid .x < m := hX
    replace hY :
        (L.env k).sreg .ctaid .y * (L.env k).sreg .ntid .y + (L.env k).sreg .tid .y < n := hY
    mojo_obl
  · clear H
    have hkept := keptF hL hsz hS h 0 rfl
    obtain ⟨⟨hcp, hce, hcw⟩, hfn, ⟨hr0, hr1, hr2, hp0, hp1, hp2⟩, ⟨hv0, hv1, hv2⟩,
      ⟨hr3, hr4, hr5⟩, hbA, hbB, hbC⟩ := h
    exact Mat.Head.iterate (c := true) (L := naiveL) (rs := [11, 12]) (loads_eq sA sB sC)
      (by mojo_inv)
      (List.forall_mem_cons.2 ⟨⟨_, hkept.2.2.1, by simp only [Val.NamesIn]; exact hne.1⟩,
        List.forall_mem_cons.2 ⟨⟨_, hkept.2.2.2.2.1, by simp only [Val.NamesIn]; exact hne.2⟩,
          fun _ h => nomatch h⟩⟩)

/-- **A thread out of bounds** at every stride: for every launch `L` valid, sizes below `2 ^ 31`,
bytes `bs` none outside the threads in bounds and thread `k` of the launch out of bounds at which
`Mat.Entry` holds with `Elem` and `Elem.Only` on its memory, the thread runs `skipF` to `ret` and
keeps both, after `k + 1` threads (`RetWith.of_first`, its obligations by mojo_obl and its
memory facts by mojo_ret). -/
theorem outF {sA sB sC : Nat} {L : Launch} (hL : L.Valid) {bC bA bB m n K : Nat}
    {α : Type} [TorchLean.Storage α] {t : Ty} {enc : α → Val} {al sA' sB' : Nat}
    {x : TorchLean.Tensor α [m, sA']} {y : TorchLean.Tensor α [n, sB']} {w : Nat}
    {bs : Nat → Option (List MemByte)}
    (hsz : m < 2 ^ 31 ∧ n < 2 ^ 31 ∧ K < 2 ^ 31)
    (hbs : ∀ k, ¬ (k < volume L.grid * volume L.block ∧ L.index k .x < m ∧ L.index k .y < n) →
      bs k = none) {k q0 q1 q2 : Nat} {c : Ctx} {m₀ m' : Mem} {f : Frame}
    (hk : k < volume L.grid * volume L.block)
    (hS : ¬ (k < volume L.grid * volume L.block ∧ L.index k .x < m ∧ L.index k .y < n))
    (h : Mat.Entry (prog sA sB sC) (fn sA sB sC) L NaiveSpec.T NaiveSpec.z 8 t enc al bC bA bB K
      sC x y k c q0 q1 q2 m' f)
    (hE : Elem m₀ bC w (fun k => (L.index k .x * sC + L.index k .y) * w) bs k m')
    (hO : Elem.Only bC (fun k => k < volume L.grid * volume L.block ∧ L.index k .x < m ∧
      L.index k .y < n) m') :
    RetWith true (Valuation.entry c 0 m' f)
      (fun me => Elem m₀ bC w (fun k => (L.index k .x * sC + L.index k .y) * w) bs (k + 1) me ∧
        Elem.Only bC (fun k => k < volume L.grid * volume L.block ∧ L.index k .x < m ∧
          L.index k .y < n) me) (skipF sA sB sC) := by
  obtain ⟨⟨hcp, hce, -⟩, hfn, ⟨hr0, hr1, hr2, hp0, hp1, hp2⟩, ⟨hv0, hv1, hv2⟩,
    ⟨hr3, hr4, hr5⟩, -, -, ⟨hbC, -⟩⟩ := h
  obtain ⟨hm, hn, hK⟩ := hsz
  have hb := hbs k hS
  rcases Nat.lt_or_ge (L.index k .x) m with hX | hX
  · have hY : n ≤ (L.env k).sreg .ctaid .y * (L.env k).sreg .ntid .y + (L.env k).sreg .tid .y :=
      Nat.le_of_not_lt fun hY => hS ⟨hk, hX, hY⟩
    replace hX :
        (L.env k).sreg .ctaid .x * (L.env k).sreg .ntid .x + (L.env k).sreg .tid .x < m := hX
    clear hS hbs
    exact RetWith.of_first (skip_hp sA sB sC) (by mojo_obl)
      fun me hme => ⟨Elem.skip (by mojo_ret) hb, by mojo_ret⟩
  · replace hX :
        m ≤ (L.env k).sreg .ctaid .x * (L.env k).sreg .ntid .x + (L.env k).sreg .tid .x := hX
    clear hS hbs
    exact RetWith.of_first (skip_hp sA sB sC) (by mojo_obl)
      fun me hme => ⟨Elem.skip (by mojo_ret) hb, by mojo_ret⟩

/-- `bytes` is none at every thread out of bounds, for every oracle family, launch, sizes, `K`
and matrices. -/
theorem bytes_out (ω : Nat → Nat → Nat) (L : Launch) {m n sA sB : Nat} (K : Nat)
    (A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA])
    (B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]) :
    ∀ k, ¬ NaiveSpec.S L m n k → bytes ω L K A B k = none :=
  fun _ hk => dite_eq_right hk

/-- binary32 fills 4 bytes in the family's layout, at every stride (the kernel evaluates it). -/
theorem size_float (sA sB sC : Nat) : (prog sA sB sC).layout.size (.fp .float) = 4 := by
  kernel_rfl

/-- Pointers of address space 0 have 64 bits in the family's layout, at every stride (the kernel
evaluates it). -/
theorem ptr_width (sA sB sC : Nat) : ((prog sA sB sC).layout.ptr 0).1 = 64 := by
  kernel_rfl

/-- The step count at the loop head does not depend on the strides: `headF`'s is
`NaiveThread.head`'s, for every stride and valuation (`Valuation.roundWith_k`). -/
theorem headF_k (sA sB sC : Nat) (V : Valuation) :
    (headF sA sB sC V).k = (NaiveThread.head V).k := by
  have h1 := (Valuation.roundWith_k true naive.fn_0.b_0.label (entryF sA sB sC)
    [(naive.fn_0.b_2.label, pre.obls, pre)] 1 V).2.2
  have h2 := (Valuation.roundWith_k true naive.fn_0.b_0.label SymSelect.entry
    [(naive.fn_0.b_2.label, pre.obls, pre)] 1 V).2.2
  simp only [Function.iterate_one] at h1 h2
  rw [h1, h2]
  rfl

/-- **The length of `pairs` is the loop's trip count** `smax(K, 0)`, for every `K ≤ sA`, `K ≤ sB`,
matrices `A` (`m × sA`), `B` (`n × sB`), row and column. -/
theorem length_pairs {m n K sA sB : Nat} (hA : K ≤ sA) (hB : K ≤ sB)
    (A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA])
    (B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]) (r : Fin m) (c : Fin n) :
    (pairs A B r c K).length = max K 0 := by
  simp only [pairs, List.length_take, List.length_ofFn]
  omega

/-- **The loop head**, for every stride, thread at which `Mat.Entry` holds and list of pairs: the
invariant holds at round 0 (`%47 = 0`, `%48 = +0`, by `obl_have`) and `%48` carries no `fmul
contract` operands (mojo_inv). -/
theorem head_inF {sA sB sC : Nat} {L : Launch} {bC bA bB m n K : Nat}
    {α : Type} [TorchLean.Storage α] {t : Ty} {enc : α → Val} {al sA' sB' : Nat}
    {x : TorchLean.Tensor α [m, sA']} {y : TorchLean.Tensor α [n, sB']}
    {k q0 q1 q2 : Nat} {c : Ctx} {m' : Mem} {f : Frame}
    (h : Mat.Entry (prog sA sB sC) (fn sA sB sC) L NaiveSpec.T NaiveSpec.z 8 t enc al bC bA bB K
      sC x y k c q0 q1 q2 m' f)
    (ps : List (Model FloatFormat.binary32 × Model FloatFormat.binary32)) :
    NaiveThread.Inv (NaiveThread.oN c 0) ps 0 (headF sA sB sC (Valuation.entry c 0 m' f)) ∧
      (headF sA sB sC (Valuation.entry c 0 m' f)).prods (idx "48") = none := by
  obtain ⟨⟨hcp, hce, hcw⟩, hfn, ⟨hr0, hr1, hr2, hp0, hp1, hp2⟩, ⟨hv0, hv1, hv2⟩,
    ⟨hr3, hr4, hr5⟩, hbA, hbB, hbC⟩ := h
  obl_have g47 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs (idx "47"),
    g48 : (headF sA sB sC (Valuation.entry c 0 m' f)).regs (idx "48")
  exact ⟨⟨g47, g48.trans (by kernel_rfl)⟩, by mojo_inv⟩

/-- **A round of the loop**, for every stride, launch `L` valid, sizes of `Mat.Pre` (`n ≤ sC`,
`K ≤ sA`, `K ≤ sB`, the products below `2 ^ 31`) and below `2 ^ 31`, thread in bounds at which
`Mat.Entry` holds, round `j < smax(K, 0)` and head `W` of round `j` at which `Mat.Head` and `Inv`
hold and `%48` carries no `fmul contract` operands: the round's premises hold (`roundsF`), and
`Inv` and that fact hold after it (`NaiveThread.round_inv`; `%47`, `%48` and the memory after the
round by `obl_have`). -/
theorem round_inF {ω : Nat → Nat → Nat} {sA sB sC : Nat} {L : Launch} (hL : L.Valid)
    {bC bA bB m n K : Nat} {A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA]}
    {B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]}
    (hsz : m < 2 ^ 31 ∧ n < 2 ^ 31 ∧ K < 2 ^ 31) (hle : n ≤ sC ∧ K ≤ sA ∧ K ≤ sB)
    (hlt : m * sC < 2 ^ 31 ∧ m * sA < 2 ^ 31 ∧ n * sB < 2 ^ 31)
    {k q0 q1 q2 : Nat} {c : Ctx} {m₀ m' : Mem} {f : Frame} (hS : NaiveSpec.S L m n k)
    (h : Mat.Entry (prog sA sB sC) (fn sA sB sC) L NaiveSpec.T NaiveSpec.z 8 (.fp .float)
      (Val.ofFloat .float) 4 bC bA bB K sC A B k c q0 q1 q2 m' f)
    {j : Nat} (hj : j < max K 0) {W : Valuation}
    (hW : W = NaiveThread.round^[j] (headF sA sB sC (Valuation.entry c 0 m' f))) (hc : W.ctx = c)
    (hk : W.k = (headF sA sB sC (Valuation.entry c 0 m' f)).k +
      j * (pathLen naiveL.H naiveL.B + 1))
    (hF : Mat.Head (prog sA sB sC) (fn sA sB sC) (.fp .float) (Val.ofFloat .float) 4 bC bA bB sC A
      B 4 (cell sC L) (bytes ω L K A B) k m₀ (NaiveSpec.S L m n) W)
    (hI : NaiveThread.Inv (NaiveThread.oN c 0) (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K) j W)
    (hp : W.prods (idx "48") = none) :
    RoundWith true naiveL.h naiveL.p naiveL.dh naiveL.H naiveL.B W ∧
      NaiveThread.Inv (NaiveThread.oN c 0) (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K) (j + 1)
        (NaiveThread.round W) ∧
      (NaiveThread.round W).prods (idx "48") = none := by
  have hl : j < (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K).length :=
    length_pairs hle.2.1 hle.2.2 _ _ _ _ ▸ hj
  rw [headF_k] at hk
  refine NaiveThread.round_inv (V := Valuation.entry c 0 m' f)
    (G := fun W => W.prods (idx "48") = none) hc hI hl hk ?_
  have hP : W.ctx.prog = prog sA sB sC := by rw [hc]; exact h.ctx.1
  obtain ⟨h16, h26, h11, h37, h12, -⟩ := keptF hL hsz hS h j hW
  have hr : L.index k .x * sA + sA ≤ m * sA := by
    have := Nat.mul_le_mul hS.2.1 (Nat.le_refl sA)
    rwa [Nat.succ_mul] at this
  have hc' : L.index k .y * sB + sB ≤ n * sB := by
    have := Nat.mul_le_mul hS.2.2 (Nat.le_refl sB)
    rwa [Nat.succ_mul] at this
  have hKA := hle.2.1
  have hKB := hle.2.2
  have hmA := hlt.2.1
  have hnB := hlt.2.2
  have hX := hS.2.1
  have hY := hS.2.2
  obtain ⟨hbA1, hbA2, hbA3⟩ := hF.bufA
  obtain ⟨hbB1, hbB2, hbB3⟩ := hF.bufB
  rw [size_float] at hbA1 hbA2 hbB1 hbB2
  replace hbA2 : W.mem.Fits naive.prog.layout bA (m * sA * 4) := hbA2
  replace hbB2 : W.mem.Fits naive.prog.layout bB (n * sB * 4) := hbB2
  replace hbA3 : W.mem.Holds naive.prog.layout bA (.fp .float) (Val.ofFloat .float)
    (rowMajor naive.prog.layout (.fp .float) 0) A := hbA3
  replace hbB3 : W.mem.Holds naive.prog.layout bB (.fp .float) (Val.ofFloat .float)
    (rowMajor naive.prog.layout (.fp .float) 0) B := hbB3
  obl_have g47 : (NaiveThread.round W).regs (idx "47"),
    e48 : (NaiveThread.round W).regs (idx "48"), hm : (NaiveThread.round W).mem
  have hctx (c l S) (V : Valuation) : (V.intoWith c l S).ctx = V.ctx :=
    (Valuation.intoWith_k _ _ _ _).1
  simp only [hctx] at e48
  have ea : (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K)[j] =
      (A.get2 ⟨_, hS.2.1⟩ ⟨j, by omega⟩, B.get2 ⟨_, hS.2.2⟩ ⟨j, by omega⟩) := by
    simp only [pairs, List.getElem_take, List.getElem_ofFn, Fin.castLE_mk]
  have e48' : (NaiveThread.round W).regs (idx "48") = some (.ofFloat .float (dotStep true
      (dotLoop true (NaiveThread.oN c 0) (Model.zero _ false)
        ((pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K).take j))
      (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K)[j]
      (W.ctx.oracle (Nat.pair ((NaiveThread.latchAt W).k + 12) 0),
        W.ctx.oracle (Nat.pair ((NaiveThread.latchAt W).k + 13) 0)))) := by
    rw [ea, TorchLean.Tensor.get2_eq_apply, TorchLean.Tensor.get2_eq_apply]
    exact e48
  refine ⟨roundsF sA sB K m n _ _ bA bB j
      (dotLoop true (NaiveThread.oN c 0) (Model.zero _ false)
        ((pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K).take j)).toBits
      A B W hle.2.1 hle.2.2 hlt.2.1 hlt.2.2 hS.2.1 hS.2.2 hr hc' hj hP hF.func hI.1 h16 hI.2 h26
      h37 h11 h12 hbA1 hbB1 hbA2 hbB2 hbA3 hbB3, ?_, g47, _,
      _, hI.2, e48', floatBin_dotStep rfl rfl rfl _ _ _ _ _⟩
  show (NaiveThread.round W).prods (idx "48") = none
  mojo_inv

/-- The entry valuation of `%67` on the path out of the loop from `W`. -/
private abbrev out7 (W : Valuation) : Valuation :=
  (W.intoWith true naive.fn_0.b_3.label hdr).intoWith true naive.fn_0.b_5.label out

/-- **The path out of the loop**, for every stride, launch `L` valid, sizes of `Mat.Pre` and below
`2 ^ 31`, thread `k` in bounds at which `Mat.Entry` holds with the oracle `ω k`, and head `W` of
round `smax(K, 0)` at which `Mat.Head` and `Inv` hold: the path walks (`exitF`, `%40` at the loop
head by mojo_inv) and returns with a memory of `Elem` after `k + 1` threads, the cell holding
`bytes ω L K A B k`, and `Elem.Only` (mojo_inv through the store). -/
theorem exit_inF {ω : Nat → Nat → Nat} {sA sB sC : Nat} {L : Launch} (hL : L.Valid)
    {bC bA bB m n K : Nat} {A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA]}
    {B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]}
    (hsz : m < 2 ^ 31 ∧ n < 2 ^ 31 ∧ K < 2 ^ 31) (hle : n ≤ sC ∧ K ≤ sA ∧ K ≤ sB)
    (hlt : m * sC < 2 ^ 31 ∧ m * sA < 2 ^ 31 ∧ n * sB < 2 ^ 31)
    {k q0 q1 q2 : Nat} {c : Ctx} {m₀ m' : Mem} {f : Frame} (hS : NaiveSpec.S L m n k)
    (h : Mat.Entry (prog sA sB sC) (fn sA sB sC) L NaiveSpec.T NaiveSpec.z 8 (.fp .float)
      (Val.ofFloat .float) 4 bC bA bB K sC A B k c q0 q1 q2 m' f) (hω : c.oracle = ω k)
    {W : Valuation}
    (hW : W = NaiveThread.round^[max K 0] (headF sA sB sC (Valuation.entry c 0 m' f)))
    (hc : W.ctx = c)
    (hF : Mat.Head (prog sA sB sC) (fn sA sB sC) (.fp .float) (Val.ofFloat .float) 4 bC bA bB sC A
      B 4 (cell sC L) (bytes ω L K A B) k m₀ (NaiveSpec.S L m n) W)
    (hI : NaiveThread.Inv (NaiveThread.oN c 0) (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K) (max K 0) W) :
    RetWith true W
      (fun me => Elem m₀ bC 4 (cell sC L) (bytes ω L K A B) (k + 1) me ∧
        Elem.Only bC (NaiveSpec.S L m n) me)
      ((naiveL.h, naiveL.dh, naiveL.H) :: naiveL.X) := by
  have h48 := hI.2
  rw [← length_pairs hle.2.1 hle.2.2 A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩, List.take_length] at h48
  have hP : W.ctx.prog = prog sA sB sC := by rw [hc]; exact h.ctx.1
  have hy : L.index k .y < sC := by have := hS.2.2; have := hle.1; omega
  have hr : L.index k .x * sC + sC ≤ m * sC := by
    have := Nat.mul_le_mul hS.2.1 (Nat.le_refl sC)
    rwa [Nat.succ_mul] at this
  obtain ⟨h16, -, -, -, -, h40⟩ := keptF hL hsz hS h _ hW
  replace h40 : W.regs (idx "40") = some (.ptr ⟨bC,
      ((L.index k .x * sC + L.index k .y) * naive.prog.layout.size (.fp .float) : Nat)⟩) := by
    refine h40.trans ?_
    obtain ⟨⟨hcp, hce, hcw⟩, hfn, ⟨hr0, hr1, hr2, hp0, hp1, hp2⟩, ⟨hv0, hv1, hv2⟩,
      ⟨hr3, hr4, hr5⟩, hbA, hbB, hbC⟩ := h
    obtain ⟨hm, hn, hK⟩ := hsz
    have hmC := hlt.1
    have hnC := hle.1
    have ⟨_, hx0, hy0⟩ := hS
    have hr' : ((L.env k).sreg .ctaid .x * (L.env k).sreg .ntid .x + (L.env k).sreg .tid .x) * sC +
      sC ≤ m * sC := hr
    have hy' :
        (L.env k).sreg .ctaid .y * (L.env k).sreg .ntid .y + (L.env k).sreg .tid .y < sC := hy
    have hs40 : 2 * (m * sC * (prog sA sB sC).layout.size (.fp .float)) <
        2 ^ ((prog sA sB sC).layout.ptr 0).1 := by
      rw [size_float, ptr_width]
      omega
    have hw40 : 64 ≤ ((prog sA sB sC).layout.ptr 0).1 := (ptr_width sA sB sC).ge
    unfold Launch.index at hx0 hy0
    mojo_inv
  have hbC1 := hF.bufC.1
  have hbC2 := hF.bufC.2
  rw [size_float] at hbC1 hbC2
  replace hbC2 : W.mem.Fits naive.prog.layout bC (m * sC * 4) := hbC2
  have hw := exitF sC K m _ _ bC
    (dotLoop true (NaiveThread.oN c 0) (Model.zero _ false)
      (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K)).toBits
    W hsz.2.2 hy hr hP hF.func hI.1 h16 h48 h40 hbC1 hbC2
  have hd : (Cond.mem fin.effs).Holds (out7 W) (vals (out7 W) fin.nodes) :=
    hw.2.2.2.2.1 _ (by decide +kernel)
  obtain ⟨me, hme⟩ := hd
  have ho : NaiveThread.oN c 0 = NaiveSpec.o (ω k) := funext fun i => by
    simp only [NaiveThread.oN, NaiveSpec.o, hω, Nat.zero_add]
  have he : (prog sA sB sC).layout.encode (.fp .float) (.ofFloat .float
      (dotLoop true (NaiveThread.oN c 0) (Model.zero _ false)
        (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K))) = bytes ω L K A B k := by
    show naive.prog.layout.encode _ _ = _
    rw [bytes, dite_eq_left hS, ho]
  have hfm : ((out7 W).intoWith true naive.fn_0.b_7.label fin).mem = me := by
    rw [Valuation.intoWith_mem]
    show (SEff.run (out7 W) (vals (out7 W) fin.nodes) fin.effs).toOption.getD (out7 W).mem = me
    rw [hme]
    rfl
  have hrun : SEff.run ((out7 W).intoWith true naive.fn_0.b_7.label fin)
      (vals ((out7 W).intoWith true naive.fn_0.b_7.label fin) Kernels.vadd.b3.nodes)
      Kernels.vadd.b3.effs = .ok me := by
    rw [show Kernels.vadd.b3.effs = [] by decide +kernel, ← hfm]
    rfl
  have hst : (prog sA sB sC).layout.stored (.fp .float) ≤ 4 :=
    (by decide : naive.prog.layout.stored (.fp .float) ≤ 4)
  refine ⟨hw, ?_, me, hrun, ?_⟩
  · kernel_rfl
  · mojo_inv

/-- **The run of a thread in bounds at every stride**, for every oracle family `ω`, launch `L`
valid, sizes of `Mat.Pre` and below `2 ^ 31`, thread `k` in bounds at which `Mat.Entry` holds with
the oracle `ω k` and `bA`, `bB` not `bC`, and memory of `Elem` after `k` threads and `Elem.Only`:
the thread runs `chainF` to `ret` with a memory of `Elem` after `k + 1` threads and `Elem.Only`
(`runF` at the invariant `NaiveThread.Inv` with `%48`'s operands none, `head_inF`, `round_inF`,
`exit_inF`). -/
theorem runInF {ω : Nat → Nat → Nat} {sA sB sC : Nat} {L : Launch} (hL : L.Valid)
    {bC bA bB m n K : Nat} {A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA]}
    {B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]}
    (hsz : m < 2 ^ 31 ∧ n < 2 ^ 31 ∧ K < 2 ^ 31) (hle : n ≤ sC ∧ K ≤ sA ∧ K ≤ sB)
    (hlt : m * sC < 2 ^ 31 ∧ m * sA < 2 ^ 31 ∧ n * sB < 2 ^ 31)
    {k q0 q1 q2 : Nat} {c : Ctx} {m₀ m' : Mem} {f : Frame} (hS : NaiveSpec.S L m n k)
    (hω : c.oracle = ω k)
    (h : Mat.Entry (prog sA sB sC) (fn sA sB sC) L NaiveSpec.T NaiveSpec.z 8 (.fp .float)
      (Val.ofFloat .float) 4 bC bA bB K sC A B k c q0 q1 q2 m' f) (hne : bA ≠ bC ∧ bB ≠ bC)
    (hE : Elem m₀ bC 4 (cell sC L) (bytes ω L K A B) k m')
    (hO : Elem.Only bC (NaiveSpec.S L m n) m') :
    RetLsWith true (fun me => Elem m₀ bC 4 (cell sC L) (bytes ω L K A B) (k + 1) me ∧
        Elem.Only bC (NaiveSpec.S L m n) me) [naiveL] (Valuation.entry c 0 m' f)
      naive.fn_0.b_0.label (entryF sA sB sC).obls (entryF sA sB sC)
      [(naive.fn_0.b_2.label, pre.obls, pre)] :=
  runF hL hsz hS h hne hE hO
    (I := fun j W =>
      NaiveThread.Inv (NaiveThread.oN c 0) (pairs A B ⟨_, hS.2.1⟩ ⟨_, hS.2.2⟩ K) j W ∧
      W.prods (idx "48") = none)
    ⟨head_inF h _,
      fun _ hj hc hk hF ⟨hI, hp⟩ => round_inF hL hsz hle hlt hS h hj rfl hc hk hF hI hp,
      fun hc _ hF ⟨hI, _⟩ => exit_inF hL hsz hle hlt hS h hω rfl hc hF hI⟩

unseal Array.anyM.loop in
/-- **The grid starts at every stride**, for every launch, arguments `Mat.args` and memory closed
for them, address choice and oracles: `Sem.Grid.start` gives a grid and a context
(`Sym.Grid.start_ok`, the parameters' checks by evaluation). -/
theorem startsF (sA sB sC : Nat) (L : Launch) (bC bA bB m n K : Nat) {mem : Mem}
    (hC : mem.Closed (Mat.args NaiveSpec.z bC bA bB m n K)) (ch : Nat → Nat)
    (oracle : Nat → Nat → Nat) :
    ∃ g c, Sem.Grid.start (prog sA sB sC) (fn sA sB sC) L (Mat.args NaiveSpec.z bC bA bB m n K)
      mem ch oracle = .ok (g, c) := by
  refine Sym.Grid.start_ok ch oracle rfl rfl hC
    (fun g hg => by rw [show (prog sA sB sC).module.globals.toList = [] from rfl] at hg; cases hg)
    (fun p v hpv t ht => ?_) (fun p v hpv hnb m' => ?_) (of_decide_eq_true (by kernel_rfl))
    (by kernel_rfl)
  all_goals
    change (p, v) ∈ naive.fn_0.params.zip _ at hpv
    simp only [Mat.args, SymPhi.naive.fn_0, List.zip_cons_cons, List.zip_nil_left,
      List.mem_cons, Prod.mk.injEq, List.not_mem_nil] at hpv
    repeat' rcases hpv with ⟨hp, hv⟩ | hpv
  all_goals subst_vars
  all_goals first
    | exact ⟨_, rfl⟩
    | simp at hnb
    | (simp at ht; subst ht; rfl)
    | simp at ht

/-- The argument codec of the naive kernel's layout (`Layout.Codec.ptrArg`). -/
private theorem codec : naive.prog.layout.Codec NaiveSpec.T fun p => .agg [.ptr p, NaiveSpec.z] :=
  Layout.Codec.ptrArg _ 0 (by decide +kernel) (by decide +kernel) rfl rfl rfl

/-- The argument type's alignment and the pointers' range are multiples of 8. -/
private theorem align8 :
    8 ∣ naive.prog.layout.align NaiveSpec.T ∧ 8 ∣ 2 ^ (naive.prog.layout.ptr 0).1 :=
  ⟨by decide, by decide⟩

/-- **The naive matmul kernel is sound at every row stride.** For every row stride and `K`: for
every `sA`, `sB`, `sC`, oracle family `ω`, launch `L` valid with `z` sides 1, sizes `m`, `n`, `K`,
blocks `bC`, `bA`, `bB`, matrices `A` (`m × sA`) and `B` (`n × sB`) and memory that meets the
matmul precondition `Mat.Pre` at the family's layout, binary32 and alignment 4 (so `n ≤ sC`,
`K ≤ min sA sB` and `m * sC`, `m * sA`, `n * sB` below `2 ^ 31`), with `m`, `n`, `K` below
`2 ^ 31` (the kernel's `i32` sizes), the program `prog sA sB sC` is sound for `Elem.Out` of
`bytes` at the cells `cell sC` (`Kernel.sound_mat`, with `runInF` and `outF`). -/
theorem sound {sA sB sC : Nat} {ω : Nat → Nat → Nat} {L : Launch} (hL : L.Valid)
    (hz : L.grid .z = 1 ∧ L.block .z = 1) {m n K bC bA bB : Nat}
    {A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, sA]}
    {B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, sB]}
    {mem : Mem} (h : Mat.Pre (prog sA sB sC).layout (.fp .float) (Val.ofFloat .float) 4 NaiveSpec.z
      mem bC bA bB m n K sA sB sC A B) (hsz : m < 2 ^ 31 ∧ n < 2 ^ 31 ∧ K < 2 ^ 31) :
    Kernel.Sound (prog sA sB sC) (fn sA sB sC) L (Mat.args NaiveSpec.z bC bA bB m n K) mem
      (fun _ ω' => ω' = ω) (fun m => some m.blocks)
      (Elem.Out mem bC (cell sC L) (bytes ω L K A B) (volume L.grid * volume L.block)) :=
  Kernel.sound_mat (contract := true) (paths := [skipF sA sB sC]) (chains := [chainF sA sB sC])
    (T := NaiveSpec.T) (al' := 8) (w := 4) hL hz (skipF_ok sA sB sC) (chainF_ok sA sB sC) rfl
    NaiveSound.naive.names ⟨rfl, rfl, rfl⟩ ⟨rfl, rfl, rfl⟩ codec align8 (fun _ => ⟨rfl, rfl, rfl⟩)
    h.closed ⟨h.ne.1.symm, h.ne.2.1.symm⟩ h.bufs h.x h.y h.le.1 h.fits
    (fun ch oracle _ => startsF sA sB sC L bC bA bB m n K h.closed ch oracle)
    (fun _ _ e _ _ _ _ _ _ _ _ hS hω hE' hE hO =>
      ⟨chainF sA sB sC, List.mem_singleton_self _,
        runInF hL hsz h.le h.lt hS (e ▸ hω) hE' ⟨h.ne.1.symm, h.ne.2.1.symm⟩ hE hO⟩)
    (fun _ _ _ _ _ _ _ _ _ _ _ hk hS _ hE' hE hO =>
      ⟨skipF sA sB sC, List.mem_singleton_self _,
        outF hL hsz (bytes_out ω L K A B) hk hS hE' hE hO⟩)

/-- **The naive kernel at the strides of tests/corpus/naive_k512/** (`512`, `512`, `256`; its
function is `fn 512 512 256` up to the kernel's name, MojoProofTest/Family.lean): `sound` there,
for every oracle family, launch valid with `z` sides 1, sizes, blocks, matrices and memory of
`Mat.Pre`, whose bounds give `m`, `n`, `K` below `2 ^ 31`. -/
theorem sound_512_512_256 {ω : Nat → Nat → Nat} {L : Launch} (hL : L.Valid)
    (hz : L.grid .z = 1 ∧ L.block .z = 1) {m n K bC bA bB : Nat}
    {A : TorchLean.Tensor (Model FloatTy.float.fmt) [m, 512]}
    {B : TorchLean.Tensor (Model FloatTy.float.fmt) [n, 512]}
    {mem : Mem} (h : Mat.Pre (prog 512 512 256).layout (.fp .float) (Val.ofFloat .float) 4
      NaiveSpec.z mem bC bA bB m n K 512 512 256 A B) :
    Kernel.Sound (prog 512 512 256) (fn 512 512 256) L (Mat.args NaiveSpec.z bC bA bB m n K) mem
      (fun _ ω' => ω' = ω) (fun m => some m.blocks)
      (Elem.Out mem bC (cell 256 L) (bytes ω L K A B) (volume L.grid * volume L.block)) :=
  sound hL hz h (by have := h.lt; have := h.le; omega)

end MojoProofTest.NaiveFam
